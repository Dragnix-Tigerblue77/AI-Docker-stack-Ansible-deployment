{% if has.Mistral %}
  # ============================================================================
  # Mistral AI -- PAID, like DeepSeek below: its API has no free access.
  #
  # Checked 2026-11-21. "docs.mistral.ai/admin/billing-usage/usage-limits" says "Free mode includes a
  # monthly usage budget for trying Vibe and Studio. It doesn't include API access. Creating API keys
  # and using the API require billing activation and pay-as-you-go", and "mistral.ai/pricing" no longer
  # shows the "$10 /mo in API credits" this section was written against on 2026-09-27. Every entry below
  # is therefore metered against a prepaid balance. They stay in the file for whoever gives a key, which
  # is optional (without it none is rendered), and sit after every free entry of the cascades they
  # appear in, right before DeepSeek. The per-model rate limits are published nowhere but the account's
  # own admin panel ("docs.mistral.ai/admin/billing-usage/usage-limits": "Review API rate limits"
  # under "Admin Panel > API > Limits"), so this file cannot state them.
  # ============================================================================
  - model_name: codestral
    litellm_params:
      model: mistral/codestral-latest
      api_key: "os.environ/MISTRAL_API_KEY"

  - model_name: codestral-2508
    litellm_params:
      model: mistral/codestral-2508
      api_key: "os.environ/MISTRAL_API_KEY"

  - model_name: mistral-medium
    litellm_params:
