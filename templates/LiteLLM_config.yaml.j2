{% if head['pro'] and head['flash'] and head['flash-lite'] %}
  # ============================================================================
  # Auto -- picks "Auto-Flash-Lite", "Auto-Flash" or "Auto-Pro" for each request, by how complex it looks
  # ============================================================================
  # For a client that cannot, or does not want to, choose its router: LibreChat leaves the choice to the person, and an
  # agent would have to hard-code it. LiteLLM's complexity router scores the request locally (its length, code, reasoning
  # and technical words, a few multi-step patterns) and rewrites the model of the request to the one the tier names, in
  # under a millisecond and with no call to a model: no classifier, no embedding, so no quota is spent to choose one.
  # A client that wants a router in particular still names it.
  #
  # The tiers name the routers and not their head models, on purpose: a request that fails after the pick falls back
  # under the name the tier gave, so each router keeps its own cascade. Measured 2026-11-23 with a head answering 429
  # and the second members failing too, behind every tier, streamed or not: the request went on to the first member that
  # answered, exactly as when the router is named. A tier naming a model directly would have none of that.
  # LiteLLM does not check a tier's name when the file loads, and a request landing on a name nobody serves fails
  # then, which is why this entry is rendered only when the three routers are.
  #
  # A model_list entry in the access group "LLM", like every entry that is not a router, because it is not an alias of
  # a head: a key limited to that group reaches it, and so reaches the members of the cascades it falls back on. That
  # second part is not optional: LiteLLM skips a fallback the caller is not authorised to call (measured 2026-11-23, a
  # key naming only "Auto" got the head's 429 back), which holds for a router named directly just the same.
  # It has no "api_key": it spends no quota of its own. Its data group is "Public-Data-Only": the cascades it falls
  # back on mix both groups, so a key for private data, which holds "Private-Data" alone, is not given it.
  #
  # REASONING goes to "Auto-Pro" with COMPLEX: one cascade serves both, and a copy of it for the last tier would be
  # a second list to keep level. No scoring key is set (weights, boundaries, keywords): the defaults are what LiteLLM
  # measured, and tuning the scorer is what its licence limits. Two settings are turned off because their
  # defaults do something this gateway does not want:
  # - "max_tokens_from_tier_model" replaces the caller's "max_tokens" with the output ceiling of the head of the picked
  #   router (measured 2026-11-23: a caller asking for 100 reached the head asking for its ceiling), so a short answer
  #   asked for is not honoured and the free quota of the head's tokens goes on a long one;
  # - "context_compaction" has a model of the tiers summarise a conversation that nears the limit of the model picked,
  #   which is a call nobody asked for and a rewrite of what the client sent.
  - model_name: Auto
    model_info:
      access_groups: ["LLM", "Public-Data-Only"]
    litellm_params:
      model: auto_router/complexity_router
      complexity_router_config:
        tiers:
          SIMPLE: Auto-Flash-Lite
          MEDIUM: Auto-Flash
          COMPLEX: Auto-Pro
          REASONING: Auto-Pro
        max_tokens_from_tier_model: false
        context_compaction: false

{% endif %}
router_settings:
  # A member that fails is not retried: the cascade below is the retry. Each retry was paid in full by
  # every member, and the head of a cascade is both what its alias points at and the first slot of its
  # list, so a head that answered 429 or stayed silent used up several attempts, and a dead head cost
  # that again on every request, since a cooldown is not kept for a member reached through an alias.
  num_retries: 0
  retry_after: 2
  cooldown_time: 60
  allowed_fails: 1
  # A member that answers "not found" is set aside for "cooldown_time" from its first such answer: its provider has
  # retired or lost it, and every request would otherwise pay that call again before moving on. Without this policy a
  # member reached through a cascade is never set aside, whatever it answers.
  allowed_fails_policy:
    NotFoundErrorAllowedFails: 0
  # Counts each entry's requests and tokens against the free limits its "rpm", "tpm", "rpd" and "tpd" state, in Redis
  # so that every worker shares the count, and skips without a call a member that has reached one: a provider at its
  # limit answers 429 only after a round trip, and the head of a cascade with 20 requests a day spends every request
  # after the twentieth that way. The figures are the free tier's, from Gemini's rate-limit page in AI Studio (per
  # model and project) and Groq's "console.groq.com/docs/rate-limits" (per model and organisation), both read
  # 2026-11-24; a provider that publishes none, or counts one quota across all its models, declares nothing, since
  # LiteLLM counts each entry apart. Entries of one model each count up to its full limit, so together they can
  # still exceed it. An "rpm" also caps the calls each worker sends to that entry at once.
  optional_pre_call_checks: ["enforce_model_rate_limits"]
  # How long a member may stay silent before the cascade moves on to the next one. They belong here and
  # not in "litellm_settings", where "stream_timeout" has no effect on the router. 90 s for a stream
  # because a model that reasons before it answers is silent until its first answer token, which the
  # slowest of our members reaches after about a minute on average; a stream whose first chunk has not
  # come by then is given up. An entry set to a level slower than that carries its own "stream_timeout" and
  # "timeout" in its "litellm_params", which LiteLLM reads before these (its source, read 2026-11-24).
  timeout: 120
  stream_timeout: 90
  # Holds each request to the "max_input_tokens" of the member about to be called, counting its tokens first: a
  # member the request does not fit is skipped without a call, where it would have answered an error after a round
  # trip, and the cascade moves on. A member that declares no window is called as before.
  enable_pre_call_checks: true

  # Shares cooldown state between the "--num_workers" processes below: without it, each worker tracks
  # its own 429s independently, and a deployment can be considered healthy by one worker while another
  # has already cooled it down (#71).
  redis_host: "redis"
  redis_port: 6379
  redis_password: os.environ/REDIS_PASSWORD

  # Every cascade below stays inside the one account's keys, end to end -- there is only one account
  # in this file for v1 (see the note at the top), so there is nothing yet for a cascade to cross.
  # "check_LiteLLM_account_isolation.py" (#32) is what keeps that true once a second account's models
  # land here.
  fallbacks:
    # Ordering rule inside every cascade below: rank by capability first, most capable to least --
    # general-intelligence leaderboards (LMArena, Artificial Analysis) for "Auto-Pro"/"Auto-Flash"/"Auto-Flash-Lite",
    # coding-specific leaderboards (SWE-bench Pro, Aider polyglot, LiveCodeBench) for "Auto-Code" and
    # "Auto-Claude-Code" -- with speed only a secondary tie-breaker and cost barely entering the comparison
    # at all, since almost every entry here is free. A model's ELIGIBILITY for a cascade is a separate
    # question from its rank inside it: it must first fit that cascade's own latency/purpose profile
    # (Auto-Flash-Lite is for simple, short asks, Auto-Pro is for unbounded reasoning, Auto-Claude-Code
    # additionally requires confirmed structured tool/function-calling support) before its capability
    # earns it a slot there -- a slow-but-brilliant model that "Auto-Pro" would take never belongs in "Auto-Flash-Lite" no matter
    # how far ahead it would rank there on intelligence alone.
    #
    # "gemini-3-8-flash" is the clearest case of the rule in practice: per Artificial Analysis'
