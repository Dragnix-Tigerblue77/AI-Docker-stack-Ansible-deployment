# LiteLLM routing configuration, RENDERED by Ansible onto the managed node.
#
# No SPDX header: like the compose template, this is written onto the node rather than kept here.
#
# #2, v1 SCOPE: one account only. Another account's models come later, as entries of its own
# carrying keys of its own (#107) -- not from its "/ui" login, which LiteLLM does not let add a
# model. No entry below carries a "model_info.access_groups": every key
# reaches every model, on purpose -- a username has no more business being hardcoded into an
# authorization label than into a hostname, and there is only one account to isolate from so far
# anyway. What #2 asks beyond this -- "access_groups"-backed teams and virtual keys created by
# idempotent Ansible tasks against LiteLLM's admin API, per-key rpm/tpm limits, the "sci-*" / "gen-*"
# sensitivity split, and the executable cross-account negative test -- is real and still open, and
# deliberately NOT attempted here; when it lands, an account's identity has to come from a role
# variable, never from a name written into this template.
# #296: only the providers whose key the caller gives are rendered. A provider without a key has no
# entry below and no slot in any cascade: a model listed that cannot answer would be tried, fail, and
# only then hand the request on. The three providers that need no key, OmniRoute, Kilo Gateway and OVHcloud AI Endpoints, are the
# exception and are always rendered.
{% set has = {
  'Gemini': Artificial_Intelligence_LiteLLM_Gemini_API_key is string and Artificial_Intelligence_LiteLLM_Gemini_API_key | length > 0,
  'Mistral': Artificial_Intelligence_LiteLLM_Mistral_API_key is string and Artificial_Intelligence_LiteLLM_Mistral_API_key | length > 0,
  'Groq': Artificial_Intelligence_LiteLLM_Groq_API_key is string and Artificial_Intelligence_LiteLLM_Groq_API_key | length > 0,
  'OpenRouter': Artificial_Intelligence_LiteLLM_OpenRouter_API_key is string and Artificial_Intelligence_LiteLLM_OpenRouter_API_key | length > 0,
  'DeepSeek': Artificial_Intelligence_LiteLLM_DeepSeek_API_key is string and Artificial_Intelligence_LiteLLM_DeepSeek_API_key | length > 0,
  'Cloudflare': Artificial_Intelligence_LiteLLM_Cloudflare_API_key is string and Artificial_Intelligence_LiteLLM_Cloudflare_API_key | length > 0,
  'Zai': Artificial_Intelligence_LiteLLM_Zai_API_key is string and Artificial_Intelligence_LiteLLM_Zai_API_key | length > 0,
  'Requesty': Artificial_Intelligence_LiteLLM_Requesty_API_key is string and Artificial_Intelligence_LiteLLM_Requesty_API_key | length > 0,
  'NVIDIA': Artificial_Intelligence_LiteLLM_NVIDIA_API_key is string and Artificial_Intelligence_LiteLLM_NVIDIA_API_key | length > 0,
  'Cent_AI': Artificial_Intelligence_LiteLLM_Cent_AI_API_key is string and Artificial_Intelligence_LiteLLM_Cent_AI_API_key | length > 0
} %}
# The routers below, the transcription and text-to-speech routers included, are aliases, whatever the keys: each stands for the first model of its own cascade
# that has a key or needs none, so that the order of a cascade alone decides and no provider is placed first
# by the way the names are built (the proxy accepts a name only if it is a model_list entry or an alias, so a
# router that exists as a cascade alone would be refused). A router is left out when no model of its cascade
# has a key or needs none, which "claude-code" and the two audio routers can come to. "check_compose_template.py" renders every
# non-empty set of keys and holds each alias to the first member of its cascade. Kilo's members sit ahead of
# the paid providers in "pro", "flash" and "flash-lite", and OmniRoute's behind them, so none of those ever
# heads one of the three, and Kilo heads "flash-lite" when neither Gemini nor OpenRouter has a key: the table
# below stops at Kilo. OVHcloud's sit behind every other free member of "pro",
# "flash", "flash-lite" and "code", ahead of the paid ones, so they head "code" when no keyed free provider
# does. Requesty's members sit right ahead of Kilo's in "flash", so Requesty heads it when no earlier
# provider has a key.
# Cent AI's sit behind Kilo's in "pro" and "flash", and among the last of "flash-lite", and in no other
# router, so it heads none.
{% set head = {
  'pro': 'gemini-4-hydrogen' if has.Gemini else 'kimi-k3-1-pro-nvidia' if has.NVIDIA else 'beam-kilo',
  'flash': 'gemini-4-hydrogen' if has.Gemini else 'kimi-k3-1-pro-nvidia' if has.NVIDIA else 'gpt-oss-120b-groq' if has.Groq else 'gpt-oss-120b-cloudflare' if has.Cloudflare else 'gemma-4-31b-free' if has.OpenRouter else 'gemma-4-31b-requesty' if has.Requesty else 'particle-1-kilo',
  'flash-lite': 'gemini-3-5-flash-lite' if has.Gemini else 'lfm-3-1-7b-free' if has.OpenRouter else 'lfm-3-1-7b-kilo',
  'code': 'gemini-4-hydrogen' if has.Gemini else 'glm-5-3-flash-nvidia' if has.NVIDIA else 'qwen3-8-27b-groq' if has.Groq else 'glm-4-7-flash-cloudflare' if has.Cloudflare else 'glm-4-7-flash-zai' if has.Zai else 'deepseek-v4-1-flash-ovh',
  'claude-code': 'gemini-4-hydrogen' if has.Gemini else 'glm-5-3-flash-nvidia' if has.NVIDIA else 'qwen3-8-27b-groq' if has.Groq else 'glm-4-7-flash-cloudflare' if has.Cloudflare else 'glm-4-7-flash-zai' if has.Zai else 'codestral' if has.Mistral else 'deepseek-v4-pro-direct' if has.DeepSeek else false,
  'stt': 'whisper-large-v3-groq' if has.Groq else 'gemini-3-5-transcribe' if has.Gemini else 'voxtral-mini-mistral' if has.Mistral else false,
  'tts': 'gemini-3-8-flash-tts' if has.Gemini else false
} %}
# Every name below stands for a router and has, under its own name, the router's cascade (#300): LiteLLM
# looks for fallbacks under the name that was ASKED for, so a request made under an alias that has no
# cascade of its own would not fall back at all. There is no alias for the names the Claude Code CLI sends
# by default: a CLI that should use one of these routers is told its name through its own model variables.
{% set aliases_of = {
  'pro': ['auto-pro'],
  'flash': ['auto', 'auto-flash', 'auto-fast'],
  'flash-lite': ['auto-flash-lite'],
  'code': ['auto-code'],
  'claude-code': [],
  'stt': [],
  'tts': ['auto-tts']
} %}
# Every entry is in exactly one access group, by its "model_info.mode": "LLM" for a text model, "STT" for
# transcription, "TTS" for speech and "Embeddings" for vectors. A virtual key limited to a group in "/ui" reaches
# the entries of that type, and the routers with them, since a router is an alias of its head and LiteLLM lets a
# key call an alias when the entry it resolves to is allowed. "check_compose_template.py" holds each entry to it.
model_list:
{% if has.Gemini %}
  # ============================================================================
  # Google AI Studio (1M+ context, developer quota)
  # ============================================================================
  # No "api_base" on any "gemini/" entry. LiteLLM's "gemini/" provider speaks Google's NATIVE API and
  # builds "<api_base>/models/<model>:generateContent" itself; pointed at Google's OpenAI-compatible
  # base ".../v1beta/openai/", that gives ".../v1beta/openai//models/...:generateContent", which Google
  # answers 404 with an empty body -- measured with litellm 1.103.0, where the default base gives
  # ".../v1beta/models/...:generateContent" and a real answer.
  #
  # Added 2026-11-21. Free of charge: the "Gemini 4 Hydrogen" table of
  # "ai.google.dev/gemini-api/docs/pricing", read that day in full, gives "Free of charge" in its Free Tier
  # column for input, output and context caching ($1.50 in / $7.50 out per million on the paid tier),
  # and its model page, "ai.google.dev/gemini-api/docs/models/gemini-4-hydrogen", lists text as its only
  # output, function calling and structured outputs as supported, a 1,048,576-token context window and
  # a stable version. Its "what's new" page, ".../docs/whats-new-gemini-4-hydrogen", says it is
  # available "on both the free and paid tiers" "across both GenerateContent and the Interactions
  # API": the call LiteLLM's "gemini/" provider makes. Artificial Analysis's ranking, read 2026-11-21 and matched by its id ("Gemini 4 Hydrogen
  # (Xhigh)", to be checked), gives it an intelligence index of 53.9 and 164.0 tokens per second:
  # ahead of "gemini-3-8-flash" (30.8) in "pro", "flash", "code" and "claude-code", and ahead of
  # "gpt-oss-20b-groq" (109.8 tokens per second) in "flash-lite". It heads "code" too: Epoch AI's coding
  # benchmarks measure it (CursorBench and ALE-Bench, read 2026-11-21) and put it ahead of
  # "gemini-3-8-flash" on the one they share, and where a model has no coding figure its intelligence
  # index stands in. The free tier's limits are counted per project and per model, not per key
  # ("ai.google.dev/gemini-api/docs/rate-limits", read 2026-11-22): 20 requests a day for this model on the
  # gateway's project, 500 for each Flash-Lite, which the "inputs" of the router contracts give in full.
  #
  # The entries of this model, and "gemini-3-8-flash" and "gemini-3-8-flash-low" below, set a static
  # "reasoning_effort", which LiteLLM sends to Google as the thinking level. One entry per level a router
  # keeps, named "<entry>-<level>", the unsuffixed name carrying the level "pro", "code" and "claude-code"
  # keep: High here, which "flash" keeps too, since High buys 9.6 points over Medium for 8.4 s, 1.1 a second,
  # above the 1 it asks (Artificial Analysis, read 2026-11-21). A static level is only a DEFAULT, a client that sends an effort replaces
  # it, and Claude Code always sends one, so it steers LibreChat and n8n and not the Claude Code agent. The
  # entries of one model draw on the same quota, which is why "flash-lite", whose members should not spend
  # the quota "pro" and "flash" need, holds its own last. No other entry sets a level: "ROUTAGE.md" says why.
  - model_name: gemini-4-hydrogen
    model_info:
      access_groups: ["LLM"]
    litellm_params:
      model: gemini/gemini-4-hydrogen
      api_key: "os.environ/GEMINI_API_KEY"
      reasoning_effort: high

  # The level "flash-lite" keeps: Medium buys 2.6 points a second, under the 3 it asks, and Low is the
  # lowest level Hydrogen has (it cannot be turned off).
  - model_name: gemini-4-hydrogen-low
    model_info:
      access_groups: ["LLM"]
    litellm_params:
      model: gemini/gemini-4-hydrogen
      api_key: "os.environ/GEMINI_API_KEY"
      reasoning_effort: low

  # In no cascade at all, reachable only when asked for by name: the highest level, which buys 3.1 points of the
  # index over High for 25.9 more seconds, 0.12 a second, under what any router asks (Artificial Analysis,
  # read 2026-11-21). Its mean time to the first answer token is 47 s and its median 76 s, so it has a
  # "stream_timeout" of its own, longer than the router's, and gives way to "gemini-4-hydrogen" when it fails.
  # It draws on the 20 requests a day of the entries above.
  - model_name: gemini-4-hydrogen-xhigh
    model_info:
      access_groups: ["LLM"]
    litellm_params:
      model: gemini/gemini-4-hydrogen
      api_key: "os.environ/GEMINI_API_KEY"
      reasoning_effort: xhigh
      stream_timeout: 180

  # GA 2026-09-02 per "ai.google.dev/gemini-api/docs/changelog", checked 2026-09-27 (this line said
  # 2026-09-13 until then). "ai.google.dev/gemini-api/docs/latest-model": "our most intelligent Flash
  # model, engineered for long-horizon software engineering, autonomous agents, and complex
  # enterprise workflows." Free of charge on the Standard tier per "ai.google.dev/gemini-api/docs/
  # pricing" -- verified directly against both pages, not assumed from the naming pattern alone.
  - model_name: gemini-3-8-flash
    model_info:
      access_groups: ["LLM"]
    litellm_params:
      model: gemini/gemini-3.8-flash
      api_key: "os.environ/GEMINI_API_KEY"
      reasoning_effort: medium

  # The level "flash" and "flash-lite" keep: Medium buys 7.6 points over Low for 9.4 s, 0.81 a second, under
  # the 1 and the 3 they ask (Artificial Analysis, read 2026-11-21). Same quota as the entry above.
  - model_name: gemini-3-8-flash-low
    model_info:
      access_groups: ["LLM"]
    litellm_params:
      model: gemini/gemini-3.8-flash
      api_key: "os.environ/GEMINI_API_KEY"
      reasoning_effort: low

  - model_name: gemini-3-7-flash
    model_info:
      access_groups: ["LLM"]
    litellm_params:
      model: gemini/gemini-3.7-flash
      api_key: "os.environ/GEMINI_API_KEY"

  - model_name: gemini-3-6-flash
    model_info:
      access_groups: ["LLM"]
    litellm_params:
      model: gemini/gemini-3.6-flash
      api_key: "os.environ/GEMINI_API_KEY"

  # Served, but not routed to: "ai.google.dev/gemini-api/docs/deprecations", read 2026-11-22, says
  # "gemini-3.5-flash" is no longer available in Google AI Studio and that its endpoint "automatically
  # routes API requests to gemini-3.6-flash", so a slot for it would answer with the model of the slot
  # next to it.
  # - model_name: gemini-3-5-flash
  #   litellm_params:
  #     model: gemini/gemini-3.5-flash
  #     api_key: "os.environ/GEMINI_API_KEY"

  - model_name: gemini-3-5-flash-lite
    model_info:
      access_groups: ["LLM"]
    litellm_params:
      model: gemini/gemini-3.5-flash-lite
      api_key: "os.environ/GEMINI_API_KEY"

  # Served, but not routed to: paid only. "ai.google.dev/gemini-api/docs/pricing", checked
  # 2026-09-27, gives "Not available" in the Free Tier column for both its input and output price,
  # so every call would be billed. The same pricing table covers the "-customtools" variant below,
  # and its "Custom Tools endpoint" row is "Not available" on the free tier too.
  # - model_name: gemini-3-1-pro
  #   litellm_params:
  #     model: gemini/gemini-3.1-pro-preview
  #     api_key: "os.environ/GEMINI_API_KEY"
  #
  # - model_name: gemini-3-1-pro-customtools
  #   litellm_params:
  #     model: gemini/gemini-3.1-pro-preview-customtools
  #     api_key: "os.environ/GEMINI_API_KEY"

  # Served, but not routed to: paid only. "ai.google.dev/gemini-api/docs/pricing", read 2026-11-02:
  # "Gemini 4 Argon is not available on the Free tier. Every token the model processes is counted
  # and billed", "Not available" in the Free Tier column of its input and output prices, and on the
  # paid tier $2.00 in / $10.00 out per million tokens through 2026-11-30, then $4.00 / $20.00.
  # - model_name: gemini-4-argon
  #   litellm_params:
  #     model: gemini/gemini-4-argon
  #     api_key: "os.environ/GEMINI_API_KEY"

  - model_name: gemini-3-1-flash-lite
    model_info:
      access_groups: ["LLM"]
    litellm_params:
      model: gemini/gemini-3.1-flash-lite
      api_key: "os.environ/GEMINI_API_KEY"

  - model_name: gemini-3-flash-preview
    model_info:
      access_groups: ["LLM"]
    litellm_params:
      model: gemini/gemini-3-flash-preview
      api_key: "os.environ/GEMINI_API_KEY"

  # Served, but not routed to, for two reasons either of which would do. It is paid only:
  # "ai.google.dev/gemini-api/docs/pricing", checked 2026-09-27, gives "Not available" in its Free
  # Tier column and describes it as "generally available to developers on the paid tier". And it is
  # not a chat model at all: the same page calls it "Our next-generation video generation and
  # editing model", which no text cascade below has any use for.
  # - model_name: gemini-omni-1-1-flash
  #   litellm_params:
  #     model: gemini/gemini-omni-1.1-flash
  #     api_key: "os.environ/GEMINI_API_KEY"

  # Served until 2026-12-01, but not routed to: "ai.google.dev/gemini-api/docs/deprecations", read
  # 2026-11-22, says "gemini-2.5-pro" is deprecated and "no longer available to select in Google AI
  # Studio", that API access is "limited to existing users who have actively used it in the past", and
  # that from 2026-12-01 its requests "automatically route to gemini-3.8-flash", which every cascade it
  # was in already holds. A key that never called it is refused today.
  # - model_name: gemini-2-5-pro
  #   litellm_params:
  #     model: gemini/gemini-2.5-pro
  #     api_key: "os.environ/GEMINI_API_KEY"

  # In no cascade at all, reachable only when asked for by name. The same page, read 2026-11-22, says
  # "gemini-2.5-flash" is deprecated and no longer available to select in Google AI Studio, and that
  # from 2026-12-01 its requests "automatically route to gemini-3.5-flash-lite". It goes when Google
  # shuts it down.
  - model_name: gemini-2-5-flash
    model_info:
      access_groups: ["LLM"]
    litellm_params:
      model: gemini/gemini-2.5-flash
      api_key: "os.environ/GEMINI_API_KEY"

  # The same page, read 2026-11-22, says "gemini-2.5-flash-lite" is not deprecated and "remains
  # available through the API until further notice".
  - model_name: gemini-2-5-flash-lite
    model_info:
      access_groups: ["LLM"]
    litellm_params:
      model: gemini/gemini-2.5-flash-lite
      api_key: "os.environ/GEMINI_API_KEY"

  # Served, but not routed to: it is an agent, not a chat model, and it is paid. Checked 2026-09-27:
  # "ai.google.dev/gemini-api/docs/models/deep-research-pro-preview-12-2025" gives its "Agent code"
  # under the "Interactions API", and ".../docs/deep-research" says the agent "is exclusively
  # available using the Interactions API. You cannot access it through generate_content" -- so not
  # through the chat-completions call LiteLLM's "gemini/" provider makes either. ".../docs/pricing"
  # charges its inference "at standard Gemini list rates", and its model page says it is "Powered
  # by Gemini 3.1 Pro", whose free tier is "Not available" (above).
  # - model_name: deep-research-pro
  #   litellm_params:
  #     model: gemini/deep-research-pro-preview-12-2025
  #     api_key: "os.environ/GEMINI_API_KEY"

  # Gemma 4 through the Gemini API itself, added 2026-09-27. Free: the "Gemma 4" table of
  # "ai.google.dev/gemini-api/docs/pricing" gives "Free of charge" for input and output on the free
  # tier, and "Not available" on the paid one. Released there 2026-04-02 (".../docs/changelog"), with
  # function calling shown on "ai.google.dev/gemma/docs/core/gemma_on_gemini_api". The same weights
  # as OpenRouter's "gemma-4-31b-free" and "gemma-4-26b-free" further down, and ranked just ahead of
  # them in the cascades for that reason: this pair spends the Gemini key's own quota, OpenRouter's
  # spends the one daily counter every ":free" model of that account shares (see its header).
  - model_name: gemma-4-31b-gemini
    model_info:
      access_groups: ["LLM"]
    litellm_params:
      model: gemini/gemma-4-31b-it
      api_key: "os.environ/GEMINI_API_KEY"

  - model_name: gemma-4-26b-gemini
    model_info:
      access_groups: ["LLM"]
    litellm_params:
      model: gemini/gemma-4-26b-a4b-it
      api_key: "os.environ/GEMINI_API_KEY"

  # An embedding model, added 2026-11-22, in no cascade and behind no alias, reached by its own name
  # alone: the vectors of two models are not comparable, so a fallback or an alias that followed the
  # keys given would silently change the vector space of a collection that is already filled.
  # "check_compose_template.py" refuses an embedding entry in any cascade or alias. The caller chooses
  # "dimensions" (LiteLLM sends it to Google as "outputDimensionality"). "ai.google.dev/gemini-api/docs/
  # embeddings", read that day, gives "Flexible, supports: 128 - 3072, Recommended: 768, 1536, 3072",
  # an input limit of 8,192 tokens, no "task_type" for this model (the task goes in the prompt) and
  # truncated vectors renormalised by Google, and says the spaces of "gemini-embedding-001" and
  # "gemini-embedding-2" are incompatible, so a switch re-embeds everything.
  # The free tier is the wrong place for private documents: its terms, known from a summary of the
  # pricing page and not read verbatim, let Google use the content to improve its products and forbid
  # personal or confidential data, and the corpus this estate routes includes third-party legal
  # documents. Embed those through a paid key, or not through this entry.
  - model_name: gemini-embedding-2
    litellm_params:
      model: gemini/gemini-embedding-2
      api_key: "os.environ/GEMINI_API_KEY"
    model_info:
      mode: embedding
      access_groups: ["Embeddings"]

  # Text to speech, for the "tts" router and for it alone (its cascade says why these two and in this
  # order). Added 2026-11-22. The speech page of the Gemini API documentation, read that day, lists
  # French as supported by both models and offers 30 prebuilt voices; "ai.google.dev/gemini-api/docs/
  # deprecations", read the same day, shuts down the three older preview speech models no earlier than
  # 2026-12-18, so none is routed. LiteLLM's own source, read the same day, serves these ids through the
  # "gemini/" provider, maps the OpenAI voice names to Gemini voices and answers WAV, or raw PCM when the
  # caller asks for "pcm". Whether the free tier covers them, and at what limits, was not read. The free
  # tier is not for sensitive text: the Gemini API terms (effective 2026-03-23), read that day, say to
  # submit none to the unpaid services and that their content is used to improve Google's products.
  - model_name: gemini-3-8-flash-tts
    litellm_params:
      model: gemini/gemini-3.8-flash-tts
      api_key: "os.environ/GEMINI_API_KEY"
    model_info:
      mode: audio_speech
      access_groups: ["TTS"]

  - model_name: gemini-3-8-flash-lite-tts
    litellm_params:
      model: gemini/gemini-3.8-flash-lite-tts
      api_key: "os.environ/GEMINI_API_KEY"
    model_info:
      mode: audio_speech
      access_groups: ["TTS"]

  # Looked at on 2026-11-02 and turned down (#305): the weekly drift report stops listing these ids,
  # and each line says why.
  # drift-ignore: gemini/gemini-3.1-flash-lite-preview -- shut down on 2026-05-25 per "ai.google.dev/gemini-api/docs/changelog" (read 2026-11-02), which says to use gemini-3.1-flash-lite, routed above; the catalogue still listed it that day
  # drift-ignore: gemini/gemini-flash-latest -- a "latest" alias, which Google hot-swaps to each new release per "ai.google.dev/gemini-api/docs/models" (read 2026-11-02): the versions are routed above by their own ids
  # drift-ignore: gemini/gemini-flash-lite-latest -- a "latest" alias, hot-swapped to each new release per "ai.google.dev/gemini-api/docs/models" (read 2026-11-02): the versions are routed above by their own ids
  # drift-ignore: gemini/gemini-pro-latest -- a "latest" alias, hot-swapped to each new release per "ai.google.dev/gemini-api/docs/models" (read 2026-11-02): the versions are routed above by their own ids
  # drift-ignore: gemini/gemini-omni-flash-preview -- a video generation and editing model per "ai.google.dev/gemini-api/docs/changelog" (read 2026-11-02), no text cascade has any use for it; its endpoint was announced for deprecation on 2026-09-30
  # Looked at on 2026-11-21 and turned down: the weekly drift report stops listing these ids.
  # drift-ignore: gemini/gemini-4-carbon -- paid only: "ai.google.dev/gemini-api/docs/pricing" (read 2026-11-21) says "Gemini 4 Carbon is not available on the Free tier" and gives "Not available" in its Free Tier column for input and output, which are $2.00 in / $10.00 out per million tokens through 2026-11-30, then $4.00 / $20.00
  # drift-ignore: gemini/gemini-4-neon -- paid only: "ai.google.dev/gemini-api/docs/pricing" (read 2026-11-21) says "Gemini 4 Neon is not available on the Free tier" and gives "Not available" in its Free Tier column for input and output, which are $3.00 in / $15.00 out per million tokens
