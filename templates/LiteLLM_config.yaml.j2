  - model_name: ling-flash-free
    litellm_params:
      model: openrouter/inclusionai/ling-3.0-flash-fin:free
      api_key: "os.environ/OPENROUTER_API_KEY_TIGERBLUE77"

  # Same Ling 3.0 Flash family as the financial-tuned sibling above, health-tuned. Kept in the same
  # flash-lite cascade slot as its sibling, on the same reasoning already applied to it: a domain
  # fine-tune is still a general-purpose fallback, not excluded from the generic cascades.
  - model_name: ling-flash-sante-free
