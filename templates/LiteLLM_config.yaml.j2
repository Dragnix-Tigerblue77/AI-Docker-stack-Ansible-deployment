router_settings:
  num_retries: 2
  retry_after: 2
  cooldown_time: 60
  allowed_fails: 1

  # Shares cooldown state between the "--num_workers" processes below: without it, each worker tracks
  # its own 429s independently, and a deployment can be considered healthy by one worker while another
  # has already cooled it down (#71).
  redis_host: "redis"
  redis_port: 6379
  redis_password: os.environ/REDIS_PASSWORD

  # Every cascade below stays inside tigerblue77's own keys, end to end -- there is only one account
  # in this file for v1 (see the note at the top), so there is nothing yet for a cascade to cross.
  # "check_LiteLLM_account_isolation.py" (#32) is what keeps that true once a second account's models
  # land here.
  fallbacks:
    # Ordering rule inside every cascade below: rank by capability first, most capable to least --
    # general-intelligence leaderboards (LMArena, Artificial Analysis) for "pro"/"flash"/"flash-lite",
    # coding-specific leaderboards (SWE-bench Pro, Aider polyglot, LiveCodeBench) for "code" and
    # "claude-code" -- with speed only a secondary tie-breaker and cost barely entering the comparison
    # at all, since almost every entry here is free. A model's ELIGIBILITY for a cascade is a separate
    # question from its rank inside it: it must first fit that cascade's own latency/purpose profile
    # (flash-lite is for atomic sub-300ms tasks, pro is for unbounded reasoning, claude-code
    # additionally requires confirmed structured tool/function-calling support) before its capability
    # earns it a slot there -- a slow-but-brilliant "pro" model never belongs in flash-lite no matter
    # how far ahead it would rank there on intelligence alone.
    #
    # "gemini-3-8-flash" is the clearest case of the rule in practice: per Artificial Analysis'
    # Intelligence Index (measured 2026-09-13) it sat marginally ahead of Gemini 3.1 Pro despite the
    # "flash" name, so it leads the pro cascade below, not just the flash one -- and Gemini 3.1 Pro
    # has since left that cascade altogether, having no free tier (see its model_list comment). Inside
    # "code", the ranking criterion switches to coding benchmarks specifically, which is what put
    # OpenRouter's free GLM 5.2 (SWE-bench Pro 62.1%) at the head of that cascade until its ":free"
    # tier was dropped (#111).
    #
    # Cost enters in two places only. DeepSeek direct (#101), the one paid provider, ranks after every
    # free entry. And Mistral's GLM pair, the dearest draw on the $10 Free mode credit every Mistral
    # entry shares, ranks after every other free entry of "code" and "claude-code" rather than where
    # its capability would put it -- see its model_list comment.

    # 1. PRO -- pure reasoning, multi-step logic, architecture.
    # Priority: Google -> OpenRouter heavy -> Mistral Large -> DeepSeek direct (#101, paid -- last
    # resort before the fully free OmniRoute) -> OmniRoute.
    - pro:
        - gemini-3-8-flash
        - gemini-2-5-pro
        - nemotron-ultra-free
        - mistral-large
        - nemotron-reasoning-free
        - deepseek-v4-pro-direct
        - omniroute-free-reasoning

    # 2. FLASH -- balanced daily driver.
    # Priority: Google Flash (1M) -> LPU (Groq) -> Mistral -> OpenRouter -> DeepSeek direct (#101,
    # paid -- last resort before the fully free OmniRoute) -> OmniRoute. Two entries sit with their
    # twin rather than with their provider: "qwen3-8-27b-free" (OpenRouter) right behind
    # "qwen3-8-27b-groq", and "gemma-4-31b-gemini" (Google) right ahead of "gemma-4-31b-free" -- the
    # same model through a second quota, ranked where the model ranks, and the OpenRouter one second
    # because its quota is the daily count all ":free" entries share. "compound-groq" dropped by #169:
    # decommissioned by Groq 2026-09-21, with no replacement.
    - flash:
        - gemini-3-8-flash
        - gemini-3-6-flash
        - gemini-3-5-flash
        - gemini-3-flash-preview
        - gpt-oss-120b-groq
        - qwen3-8-27b-groq
        - qwen3-8-27b-free
        - mistral-small
        - ministral-14b
        - ministral-8b
        - nemotron-super-free
        - gemma-4-31b-gemini
        - gemma-4-31b-free
        - openrouter-auto-free
        - deepseek-flash-direct
        - omniroute-free-auto

    # 3. FLASH-LITE -- atomic micro-tasks (<300ms). Accepts short-context (4k-32k) models for
    # ultra-high speed. "compound-mini-groq" and "qwen3-6-27b-groq" dropped by #169, both retired by
    # Groq in September 2026 and deleted from the model_list; "qwen3-8-27b-groq", Groq's designated
    # successor to the latter, holds its slot -- where the POC ranked its predecessor, until the test
    # bench (#85) measures whether its latency earns it a higher or a lower one. "gemma-4-26b-gemini"
    # sits right ahead of its OpenRouter twin, for the reason given under FLASH.
    - flash-lite:
        - gemini-3-1-flash-lite
        - gemini-2-5-flash-lite
        - ministral-3b
        - gpt-oss-20b-groq
        - qwen3-8-27b-groq
        - gemma-4-26b-gemini
        - gemma-4-26b-free
        - nemotron-lightning-free
        - ling-flash-free
        - ling-flash-sante-free
        - inkling-small-free
        - dots-note-free
        - poolside-laguna-xs-free
        - lfm-free

    # 4. CODE -- refactoring, Ansible playbooks, Bash/Python scripts. Excludes FIM (raw token) models.
    # Ranked by coding-specific benchmarks (SWE-bench Pro, Aider polyglot, LiveCodeBench) rather than
    # general intelligence -- measured 2026-09-13, sources in the model_list comments above. This is
    # why "codestral" -- Mistral's own dedicated code model -- sits near the bottom rather than the
    # top: no current coding-benchmark placement could be found for it (a weak predecessor proxy). Its
    # sibling "mistral-code-agent" is gone from this cascade entirely, not just reordered: #112 found no
    # evidence "mistral-code-agent-latest" was ever a currently published Mistral model id.
    # Priority: syntax/code specialists -> Mistral's GLM pair (the dearest draw on its $10 credit) ->
    # DeepSeek direct (#101, paid -- last resort before the fully free OmniRoute) -> OmniRoute.
    - code:
        - gemini-3-8-flash
        - qwen3-8-27b-groq
        - qwen3-8-27b-free
        - gemini-3-6-flash
        - gemini-3-5-flash
        - codestral
        - codestral-2508
        - poolside-laguna-s-free
        - north-mini-code-free
        - glm-5-3-mistral
        - glm-5-2-mistral
        - deepseek-v4-pro-direct
        - omniroute-free-code

    # 5. CLAUDE-CODE -- 100% agentic CLI (strict tool/function calling, 128k+ context). Excludes
    # models with no structured tool support (e.g. mistral-vibe-cli). DeepSeek direct (#101) is last:
    # both its models support tool calls, but it is the only paid provider in this cascade.
    # "glm-5-3-mistral" is just ahead of it, and alone of its pair: an agentic session resends its
    # whole context on every turn, and at $1.4 per 1M input tokens a session at 128k context spends
    # the whole $10 credit in about fifty uncached turns -- one GLM slot is as much as it carries.
    - claude-code:
        - gemini-3-8-flash
        - gemini-2-5-pro
        - gemini-3-6-flash
        - gemini-3-5-flash
        - mistral-large
        - codestral
        - glm-5-3-mistral
        - deepseek-v4-pro-direct

  # Transparent alias mappings.
  model_group_alias:
    "auto": "flash"
    "auto-flash": "flash"
    "auto-pro": "pro"
    "auto-flash-lite": "flash-lite"
    "auto-code": "code"
    "auto-fast": "flash"

    # Intercepts the Claude Code CLI's own model names, per issue #13's compliance note: none of
    # these ever reach a real Anthropic model backed by a subscription.
    "claude-3-7-sonnet": "claude-code"
    "claude-3-7-sonnet-20250219": "claude-code"
    "claude-3-5-sonnet": "claude-code"
    "claude-3-5-sonnet-20241022": "claude-code"
    "claude-3-opus": "pro"
    "claude-3-opus-20240229": "pro"
    "claude-3-5-haiku": "flash-lite"
    "claude-3-5-haiku-20241022": "flash-lite"

general_settings:
  # The master key and the database URL are read from the environment rather than written here: this
  # file is mounted read-only into the container and would otherwise carry both in clear text.
  master_key: os.environ/LITELLM_MASTER_KEY
  database_url: os.environ/DATABASE_URL
  redis_url: os.environ/REDIS_URL

litellm_settings:
  request_timeout: 120          # long enough for heavy reasoning models' thinking phase
  telemetry: false               # no outbound telemetry
  drop_params: true              # silently drops hyperparameters a given model does not support
  modify_params: true            # translates tool-call schemas between Anthropic and OpenAI/Gemini
  stream_timeout: 120            # extended timeout for models' reasoning phase
  force_ipv4: true               # avoids slow IPv6 resolution on the target VM
  stream_response_threshold: 0   # flushes SSE chunks to the client immediately
  # Keep the gateway's own logging free of prompt and response bodies. The corpus this estate routes
  # includes third-party legal documents, and a debug log is a copy of them nobody decided to keep.
  turn_off_message_logging: true

  # Response caching, to preserve the free tiers' TPM quotas (#71). Upstream documents proxy-level
  # caching as key/team/org-scoped by default, which would mean a cached answer never crosses an
  # account boundary -- but that scoping is NOT verified from this session (no Docker daemon to test
  # against), and #71's own Definition of Done says so explicitly. Confirm it on the test bench
  # before trusting it: this is exactly the kind of guarantee #2 exists to hold accountable.
  enable_caching: true
  cache_params:
    type: "redis"
    supported_call_types: ["completion", "cache_read", "cache_write"]
