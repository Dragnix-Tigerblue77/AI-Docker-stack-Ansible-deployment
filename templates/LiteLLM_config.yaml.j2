# LiteLLM routing configuration, RENDERED by Ansible onto the managed node.
#
# No SPDX header: like the compose template, this is written onto the node rather than kept here.
#
# #2, v1 SCOPE: one account only. Another account's models come later, as entries of its own
# carrying keys of its own (#107) -- not from its "/ui" login, which LiteLLM does not let add a
# model. No access group below names an account: each entry carries the one its kind of model
# maps to, and a key nobody restricted reaches every model -- a username has no more business
# being hardcoded into an authorization label than into a hostname, and there is only one account
# to isolate from so far
# anyway. What #2 asks beyond this -- "access_groups"-backed teams and virtual keys created by
# idempotent Ansible tasks against LiteLLM's admin API, per-key rpm/tpm limits, a split of the entries
# by the sensitivity of their data, and the executable cross-account negative test -- is real and still open, and
# deliberately NOT attempted here; when it lands, an account's identity has to come from a role
# variable, never from a name written into this template.
# #296: only the providers whose key the caller gives are rendered. A provider without a key has no
# entry below and no slot in any cascade: a model listed that cannot answer would be tried, fail, and
# only then hand the request on. The three providers that need no key, OmniRoute, Kilo Gateway and OVHcloud AI Endpoints, are the
# exception and are always rendered.
{% set has = {
  'Gemini': Artificial_Intelligence_LiteLLM_Gemini_API_key is string and Artificial_Intelligence_LiteLLM_Gemini_API_key | length > 0,
  'Mistral': Artificial_Intelligence_LiteLLM_Mistral_API_key is string and Artificial_Intelligence_LiteLLM_Mistral_API_key | length > 0,
  'Groq': Artificial_Intelligence_LiteLLM_Groq_API_key is string and Artificial_Intelligence_LiteLLM_Groq_API_key | length > 0,
  'OpenRouter': Artificial_Intelligence_LiteLLM_OpenRouter_API_key is string and Artificial_Intelligence_LiteLLM_OpenRouter_API_key | length > 0,
  'DeepSeek': Artificial_Intelligence_LiteLLM_DeepSeek_API_key is string and Artificial_Intelligence_LiteLLM_DeepSeek_API_key | length > 0,
  'Cloudflare': Artificial_Intelligence_LiteLLM_Cloudflare_API_key is string and Artificial_Intelligence_LiteLLM_Cloudflare_API_key | length > 0,
  'Zai': Artificial_Intelligence_LiteLLM_Zai_API_key is string and Artificial_Intelligence_LiteLLM_Zai_API_key | length > 0,
  'Requesty': Artificial_Intelligence_LiteLLM_Requesty_API_key is string and Artificial_Intelligence_LiteLLM_Requesty_API_key | length > 0,
  'NVIDIA': Artificial_Intelligence_LiteLLM_NVIDIA_API_key is string and Artificial_Intelligence_LiteLLM_NVIDIA_API_key | length > 0,
  'Cent_AI': Artificial_Intelligence_LiteLLM_Cent_AI_API_key is string and Artificial_Intelligence_LiteLLM_Cent_AI_API_key | length > 0,
  'Aion_Labs': Artificial_Intelligence_LiteLLM_Aion_Labs_API_key is string and Artificial_Intelligence_LiteLLM_Aion_Labs_API_key | length > 0,
  'Vercel_AI_Gateway': Artificial_Intelligence_LiteLLM_Vercel_AI_Gateway_API_key is string and Artificial_Intelligence_LiteLLM_Vercel_AI_Gateway_API_key | length > 0
} %}
# The routers below, the transcription and text-to-speech routers included, are aliases, whatever the keys: each stands for the first model of its own cascade
# that has a key or needs none, so that the order of a cascade alone decides and no provider is placed first
# by the way the names are built (the proxy accepts a name only if it is a model_list entry or an alias, so a
# router that exists as a cascade alone would be refused). A router is left out when no model of its cascade
# has a key or needs none, which "Auto-Claude-Code" and the two audio routers can come to. "check_compose_template.py" renders the file for
# sets of keys that cover every case of the keys one condition reads, and holds each alias to the first member of its cascade. Kilo's members sit ahead of
# the paid providers in "Auto-Pro", "Auto-Flash" and "Auto-Flash-Lite", and OmniRoute's behind them, so none of those ever
# heads one of the three, and Kilo heads "Auto-Flash-Lite" when neither Gemini nor OpenRouter has a key: the table
# below stops at Kilo. OVHcloud's sit behind every other free member of "Auto-Pro",
# "Auto-Flash", "Auto-Flash-Lite" and "Auto-Code", ahead of the paid ones, so they head "Auto-Code" when no keyed free provider
# does. Requesty's "ling-3-1-flash-requesty", which Artificial Analysis's index of 30 places behind the Gemini
# entries and ahead of NVIDIA's lesser ones, heads "Auto-Pro" and "Auto-Flash" when neither Gemini nor NVIDIA has a
# key, and the rest of Requesty's members sit right ahead of Kilo's in "Auto-Flash".
# Cent AI's sit behind Kilo's in "Auto-Pro" and "Auto-Flash", and among the last of "Auto-Flash-Lite", and in no other
# router, so it heads none. Aion Labs' sit in "Auto-Fiction" and in no other router, which they alone make up, so
# it heads that one and no other. Vercel AI Gateway's sit by their figures, in "Auto-Pro" and "Auto-Flash" right behind
# Gemini 3.8 Flash and ahead of the first of Groq's, so it heads both when neither Gemini nor NVIDIA has a key; in
# "Auto-Flash-Lite" they sit behind their twins, and in no other router.
{% set head = {
  'pro': 'gemini-4-hydrogen' if has.Gemini else 'kimi-k3-1-pro-nvidia' if has.NVIDIA else 'inkling-2-small-vercel' if has.Vercel_AI_Gateway else 'ling-3-1-flash-requesty' if has.Requesty else 'beam-kilo',
  'flash': 'gemini-4-hydrogen' if has.Gemini else 'kimi-k3-1-pro-nvidia' if has.NVIDIA else 'inkling-2-small-vercel' if has.Vercel_AI_Gateway else 'ling-3-1-flash-requesty' if has.Requesty else 'gpt-oss-120b-groq' if has.Groq else 'gpt-oss-120b-cloudflare' if has.Cloudflare else 'gemma-4-31b-free' if has.OpenRouter else 'particle-1-kilo',
  'flash-lite': 'gemini-3-5-flash-lite' if has.Gemini else 'lfm-3-1-7b-free' if has.OpenRouter else 'lfm-3-1-7b-kilo',
  'code': 'gemini-4-hydrogen' if has.Gemini else 'glm-5-3-flash-nvidia' if has.NVIDIA else 'qwen3-8-27b-groq' if has.Groq else 'glm-4-7-flash-cloudflare' if has.Cloudflare else 'glm-4-7-flash-zai' if has.Zai else 'deepseek-v4-1-flash-ovh',
  'claude-code': 'gemini-4-hydrogen' if has.Gemini else 'glm-5-3-flash-nvidia' if has.NVIDIA else 'qwen3-8-27b-groq' if has.Groq else 'glm-4-7-flash-cloudflare' if has.Cloudflare else 'glm-4-7-flash-zai' if has.Zai else 'codestral' if has.Mistral else 'deepseek-v4-pro-direct' if has.DeepSeek else false,
  'stt': 'whisper-large-v3-groq' if has.Groq else 'gemini-3-5-transcribe' if has.Gemini else 'voxtral-mini-mistral' if has.Mistral else false,
  'tts': 'gemini-3-8-flash-tts' if has.Gemini else false,
  'decision': 'clef-cloudflare' if has.Cloudflare else false,
  'extraction': 'clairic-cloudflare' if has.Cloudflare else false,
  'fiction': 'aion-3-5-aion-labs' if has.Aion_Labs else false
} %}
# The provider keys are named credentials, declared by "credential_list" below, and an entry says
# "litellm_credential_name" where it used to say "api_key". LiteLLM resolves the name when it sends the
# request and hands the entry the credential's key, which reaches the provider exactly as the key written
# on the entry did; an "api_key" on an entry would win over its credential's, which is why none carries
# both. The environment variable stays the one place a key comes from: a credential only reads it, and
# "/ui" lists what is declared here under "LLM Credentials", masked and read-only.
# A credential is never added or edited from "/ui": one saved there under a name declared here would take
# the place of the declared one at the next start, and its key would stop being the one in the vault.
# One credential per variable read, named after it ("<provider>", and "<provider>-<label>" for another
# account's), so that the account an entry spends is still the variable its credential names, which
# "check_LiteLLM_account_isolation.py" follows. A name no credential declares is not an error to LiteLLM:
# the request goes out without a key, which "check_compose_template.py" and that check refuse. The keyless
# gateways have no credential: their "api_key" is a literal marker, not a secret. "credential_info" is
# required by LiteLLM, which refuses to start on a credential without it, and holds nothing here.
credential_list:
{% if has.Gemini %}
  - credential_name: gemini
    credential_info: {}
    credential_values:
      api_key: "os.environ/GEMINI_API_KEY"
{% endif %}
{% if has.Mistral %}
  - credential_name: mistral
    credential_info: {}
    credential_values:
      api_key: "os.environ/MISTRAL_API_KEY"
{% endif %}
{% if has.Groq %}
  - credential_name: groq
    credential_info: {}
    credential_values:
      api_key: "os.environ/GROQ_API_KEY"
{% endif %}
{% if has.OpenRouter %}
  - credential_name: openrouter
    credential_info: {}
    credential_values:
      api_key: "os.environ/OPENROUTER_API_KEY"
{% endif %}
{% if has.DeepSeek %}
  - credential_name: deepseek
    credential_info: {}
    credential_values:
      api_key: "os.environ/DEEPSEEK_API_KEY"
{% endif %}
{% if has.Cloudflare %}
  - credential_name: cloudflare
    credential_info: {}
    credential_values:
      api_key: "os.environ/CLOUDFLARE_API_KEY"
{% endif %}
{% if has.Zai %}
  - credential_name: zai
    credential_info: {}
    credential_values:
      api_key: "os.environ/ZAI_API_KEY"
{% endif %}
{% if has.Requesty %}
  - credential_name: requesty
    credential_info: {}
    credential_values:
      api_key: "os.environ/REQUESTY_API_KEY"
{% endif %}
{% if has.NVIDIA %}
  - credential_name: nvidia-nim
    credential_info: {}
    credential_values:
      api_key: "os.environ/NVIDIA_NIM_API_KEY"
{% endif %}
{% if has.Cent_AI %}
  - credential_name: cent-ai
    credential_info: {}
    credential_values:
      api_key: "os.environ/CENT_AI_API_KEY"
{% endif %}
{% if has.Aion_Labs %}
  - credential_name: aion-labs
    credential_info: {}
    credential_values:
      api_key: "os.environ/AION_LABS_API_KEY"
{% endif %}
  # Declared when their providers are given a key and their entries are put back:
  # - credential_name: cerebras
  #   credential_info: {}
  #   credential_values:
  #     api_key: "os.environ/CEREBRAS_API_KEY"
  # - credential_name: sambanova
  #   credential_info: {}
  #   credential_values:
  #     api_key: "os.environ/SAMBANOVA_API_KEY"
# A router is published under one name only, the one a client types: "Auto-Pro", "Auto-Flash", "Auto-Flash-Lite",
# "Auto-Code", "Auto-Claude-Code", "Auto-STT", "Auto-TTS", "Auto-Decision", "Auto-Extraction" and "Auto-Fiction". It has, under that name, the router's cascade:
# LiteLLM looks for fallbacks under the name that was ASKED for, so a name that is an alias and has no cascade
# of its own would not fall back at all. The name of this file's own variable ("head") is the
# short one the checks and the routing document use, and the checks translate between the two. There is no
# alias for the names the Claude Code CLI sends by default: a CLI that should use one of these routers is told
# its name through its own model variables.
# "Auto" is the one name that is not a router of that kind: it is a model_list entry that picks one of "Auto-Pro",
# "Auto-Flash" and "Auto-Flash-Lite" for each request, by how complex the request looks, and it has no cascade and no
# alias of its own, since the router it picks has its own. Its entry, at the end of the model list, says why it is built so.
# Every entry is in exactly one access group, by its "model_info.mode": "LLM" for a text model, "STT" for
# transcription, "TTS" for speech, "Embeddings" for vectors, "Decisions" for Clef's decisions ("evaluation") and
# "Extraction" for Clairic's extraction. A virtual key limited to a group in "/ui" reaches
# the entries of that type, and the routers with them, since a router is an alias of its head and LiteLLM lets a
# key call an alias when the entry it resolves to is allowed. "check_compose_template.py" holds each entry to it.
# One exception, on purpose: Aion Labs' text models, tuned for role-play and fiction and unmoderated, are in a group
# of their own, "Fiction", and not in "LLM", so that no key holding "LLM" reaches them, "Auto-Fiction" being the one
# router that holds them. A key reaches them only when "Fiction" or "Auto-Fiction" is named in its models.
# A text entry's "model_info" also carries its sheet as its provider serves it, which is often smaller than what the
# model's maker announces: "max_input_tokens", the context window, which the router's pre-call checks hold a request
# to, skipping without a call a member it does not fit; "max_output_tokens", the longest answer, which a length an
# entry sets may not exceed; "supports_vision", whether it takes images. A figure the provider does not publish is
# left out. Read 2026-11-24 from: Gemini "ai.google.dev/gemini-api/docs/models/<model>" and, for Gemma,
# "ai.google.dev/gemma/docs/core"; Groq "console.groq.com/docs/model/<id>"; Cloudflare
# "developers.cloudflare.com/workers-ai/models/<slug>/"; OpenRouter, Kilo, Requesty, OVHcloud and Aion Labs, the
# "/models" list of their API ("openrouter.ai/api/v1/models" and the same path on the others' "api_base");
# NVIDIA "build.nvidia.com/<publisher>/<model>/modelcard"; Mistral "docs.mistral.ai/models/<model>.md"; DeepSeek
# "api-docs.deepseek.com/quick_start/pricing"; Z AI "docs.z.ai/guides/llm/glm-4.7" and, for GLM-4.5-Flash, "docs.z.ai/guides/llm/glm-4.5"; Cent AI "cent-ai.dev/models".
# "check_compose_template.py" requires the window of every member of a cascade.
# Every entry is also in exactly one of two groups that say what its provider does with the data sent to it,
# written after its type group: "Private-Data" for a provider whose own terms leave prompts and outputs untrained,
# unreviewed and unkept beyond a short abuse-monitoring period, run by a known company under the GDPR or terms
# as good, and "Public-Data-Only" for every other, fit only for what one would accept to see published. A key
# for sensitive work is given "Private-Data" by name and nothing else: a LiteLLM group is an allow-list, so the
# other group is a label and no key is ever given it. The routers are in no group and their cascades mix
# both, so such a key must not be given a router. The provider decides it, in "check_compose_template.py", with the
# reason and the page read.
# The members of "Auto-Claude-Code" are also in "Claude-Code", written last, after their data group, and no other
# entry is: the agent's key holds that group, since LiteLLM checks the calling key before each fallback and skips a member it does not allow, and the
# cascade's members are the models that take strict tool calls on enough context, which the agent cannot do without.
model_list:
{% if has.Gemini %}
  # ============================================================================
  # Google AI Studio (1M+ context, developer quota)
  # ============================================================================
  # No "api_base" on any "gemini/" entry. LiteLLM's "gemini/" provider speaks Google's NATIVE API and
  # builds "<api_base>/models/<model>:generateContent" itself; pointed at Google's OpenAI-compatible
  # base ".../v1beta/openai/", that gives ".../v1beta/openai//models/...:generateContent", which Google
  # answers 404 with an empty body -- measured with litellm 1.103.0, where the default base gives
  # ".../v1beta/models/...:generateContent" and a real answer.
  #
  # Added 2026-11-21. Free of charge: the "Gemini 4 Hydrogen" table of
  # "ai.google.dev/gemini-api/docs/pricing", read that day in full, gives "Free of charge" in its Free Tier
  # column for input, output and context caching ($1.50 in / $7.50 out per million on the paid tier),
  # and its model page, "ai.google.dev/gemini-api/docs/models/gemini-4-hydrogen", lists text as its only
  # output, function calling and structured outputs as supported, a 1,048,576-token context window and
  # a stable version. Its "what's new" page, ".../docs/whats-new-gemini-4-hydrogen", says it is
  # available "on both the free and paid tiers" "across both GenerateContent and the Interactions
  # API": the call LiteLLM's "gemini/" provider makes. Artificial Analysis's ranking, read 2026-11-21 and matched by its id ("Gemini 4 Hydrogen
  # (Xhigh)", to be checked), gives it an intelligence index of 53.9 and 164.0 tokens per second:
  # ahead of "gemini-3-8-flash" (30.8) in "Auto-Pro", "Auto-Flash", "Auto-Code" and "Auto-Claude-Code", and ahead of
  # "gpt-oss-20b-groq" (109.8 tokens per second) in "Auto-Flash-Lite". It heads "Auto-Code" too: Epoch AI's coding
  # benchmarks measure it (CursorBench and ALE-Bench, read 2026-11-21) and put it ahead of
  # "gemini-3-8-flash" on the one they share, and where a model has no coding figure its intelligence
  # index stands in. The free tier's limits are counted per project and per model, not per key
  # ("ai.google.dev/gemini-api/docs/rate-limits", read 2026-11-22): 20 requests a day for this model on the
  # gateway's project, 500 for each Flash-Lite, which the "inputs" of the router contracts give in full.
  #
  # The level an entry sets follows how its provider counts the free tier: the highest level the model accepts
  # where requests are counted, as Google counts them, since thinking longer then costs time only; none where
  # tokens are counted or on a paid provider, which keeps the model's own default. "Auto-Flash-Lite" is ranked
  # on time, so a model it shares with another router has one entry per level, named "<entry>-<level>", the
  # unsuffixed name carrying the highest.
  # "check_compose_template.py" holds each level to the values its model accepts, and "ROUTAGE.md" says where
  # each entry stands. A static level is only a DEFAULT: a client that sends an effort replaces it, and Claude
  # Code always sends one. The entries of one model draw on the same quota, which is why "Auto-Flash-Lite",
  # whose members should not spend the quota "Auto-Pro" and "Auto-Flash" need, holds its own last.
  #
  # Xhigh, the highest level Hydrogen takes, is slower to answer than the router waits: Artificial Analysis
  # (read 2026-11-21) gives it 47 s on average to the first answer token and 76 s in the median, so the entry
  # waits 180 s for that token, more than twice the median, and 240 s for a whole answer that is not streamed,
  # where a minute more writes thousands of tokens at its 164 a second. LiteLLM reads an entry's own timeouts
  # before the router's (its source, read 2026-11-24).
  - model_name: gemini-4-hydrogen
    model_info:
      access_groups: ["LLM", "Private-Data", "Claude-Code"]
      max_input_tokens: 1048576
      max_output_tokens: 65536
      supports_vision: true
    litellm_params:
      model: gemini/gemini-4-hydrogen
      litellm_credential_name: "gemini"
      rpm: 5
      tpm: 250000
      rpd: 20
      reasoning_effort: xhigh
      stream_timeout: 180
      timeout: 240

  # The level "Auto-Flash-Lite" keeps: Medium buys 2.6 points a second, under the 3 it asks, and Low is the
  # lowest level Hydrogen has (it cannot be turned off).
  - model_name: gemini-4-hydrogen-low
    model_info:
      access_groups: ["LLM", "Private-Data"]
      max_input_tokens: 1048576
      max_output_tokens: 65536
      supports_vision: true
    litellm_params:
      model: gemini/gemini-4-hydrogen
      litellm_credential_name: "gemini"
      rpm: 5
      tpm: 250000
      rpd: 20
      reasoning_effort: low

  # GA 2026-09-02 per "ai.google.dev/gemini-api/docs/changelog", checked 2026-09-27 (this line said
  # 2026-09-13 until then). "ai.google.dev/gemini-api/docs/latest-model": "our most intelligent Flash
  # model, engineered for long-horizon software engineering, autonomous agents, and complex
  # enterprise workflows." Free of charge on the Standard tier per "ai.google.dev/gemini-api/docs/
  # pricing" -- verified directly against both pages, not assumed from the naming pattern alone.
  # High is the highest level it takes ("ai.google.dev/gemini-api/docs/thinking", read 2026-11-24): 28.1 s to the
  # first answer token (Artificial Analysis, read 2026-11-21), under a third of the router's wait, so it keeps
  # the router's timeouts.
  - model_name: gemini-3-8-flash
    model_info:
      access_groups: ["LLM", "Private-Data", "Claude-Code"]
      max_input_tokens: 1048576
      max_output_tokens: 65536
      supports_vision: true
    litellm_params:
      model: gemini/gemini-3.8-flash
      litellm_credential_name: "gemini"
      rpm: 5
      tpm: 250000
      rpd: 20
      reasoning_effort: high

  # The level "Auto-Flash-Lite" keeps: Medium buys 7.6 points over Low for 9.4 s, 0.81 a second, under the 3 it
  # asks (Artificial Analysis, read 2026-11-21). Same quota as the entry above.
  - model_name: gemini-3-8-flash-low
    model_info:
      access_groups: ["LLM", "Private-Data"]
      max_input_tokens: 1048576
      max_output_tokens: 65536
      supports_vision: true
    litellm_params:
      model: gemini/gemini-3.8-flash
      litellm_credential_name: "gemini"
      rpm: 5
      tpm: 250000
      rpd: 20
      reasoning_effort: low

  # A twin of "gemini-3-8-flash", placed right behind it in every cascade that holds that model.
  # "ai.google.dev/gemini-api/docs/deprecations", read 2026-11-24, says "gemini-3.7-flash" is no longer available in
  # Google AI Studio and that its endpoint "is not shutting down and automatically routes API requests to
  # gemini-3.8-flash". Whether a call to this id draws on a counter of its own or on the one of Gemini 3.8 Flash is
  # not established: the rate-limits page of the gateway's project in Google AI Studio has no row for it (read
  # 2026-11-22). The slot costs one refusal when the counter is shared and is 20 more requests a day when it is
  # not. To settle it, send one request to this id and see which counter moves on the usage page of AI Studio; if it
  # is the one of Gemini 3.8 Flash, delete the entry.
  - model_name: gemini-3-7-flash
    model_info:
      access_groups: ["LLM", "Private-Data", "Claude-Code"]
      max_input_tokens: 1048576
      max_output_tokens: 65536
      supports_vision: true
    litellm_params:
      model: gemini/gemini-3.7-flash
      litellm_credential_name: "gemini"

  # High, the highest level it takes ("ai.google.dev/gemini-api/docs/thinking", read 2026-11-24), is the one level
  # Artificial Analysis ranks it at, 12.6 s to the first answer token (read 2026-11-21): the router's timeouts hold.
  - model_name: gemini-3-6-flash
    model_info:
      access_groups: ["LLM", "Private-Data", "Claude-Code"]
      max_input_tokens: 1048576
      max_output_tokens: 65536
      supports_vision: true
    litellm_params:
      model: gemini/gemini-3.6-flash
      litellm_credential_name: "gemini"
      rpm: 5
      tpm: 250000
      rpd: 20
      reasoning_effort: high

  # Served, but not routed to: "ai.google.dev/gemini-api/docs/deprecations", read 2026-11-22, says
  # "gemini-3.5-flash" is no longer available in Google AI Studio and that its endpoint "automatically
  # routes API requests to gemini-3.6-flash", so a slot for it would answer with the model of the slot
  # next to it.
  # - model_name: gemini-3-5-flash
  #   litellm_params:
  #     model: gemini/gemini-3.5-flash
  #     litellm_credential_name: "gemini"

  - model_name: gemini-3-5-flash-lite
    model_info:
      access_groups: ["LLM", "Private-Data"]
      max_input_tokens: 1048576
      max_output_tokens: 65536
      supports_vision: true
    litellm_params:
      model: gemini/gemini-3.5-flash-lite
      litellm_credential_name: "gemini"
      rpm: 15
      tpm: 250000
      rpd: 500

  # Served, but not routed to: paid only. "ai.google.dev/gemini-api/docs/pricing", checked
  # 2026-09-27, gives "Not available" in the Free Tier column for both its input and output price,
  # so every call would be billed. The same pricing table covers the "-customtools" variant below,
  # and its "Custom Tools endpoint" row is "Not available" on the free tier too.
  # - model_name: gemini-3-1-pro
  #   litellm_params:
  #     model: gemini/gemini-3.1-pro-preview
  #     litellm_credential_name: "gemini"
  #
  # - model_name: gemini-3-1-pro-customtools
  #   litellm_params:
  #     model: gemini/gemini-3.1-pro-preview-customtools
  #     litellm_credential_name: "gemini"

  # Served, but not routed to: paid only. "ai.google.dev/gemini-api/docs/pricing", read 2026-11-02:
  # "Gemini 4 Argon is not available on the Free tier. Every token the model processes is counted
