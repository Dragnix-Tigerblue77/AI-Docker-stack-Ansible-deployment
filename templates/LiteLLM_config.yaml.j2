      model: openrouter/openrouter/free
      api_key: "os.environ/OPENROUTER_API_KEY_TIGERBLUE77"

  # Served, but not routed to: a guardrail, not a generator. The catalogue describes
  # "nvidia/nemotron-3.5-content-safety:free" as "a compact 4B-parameter multimodal guardrail model"
  # that "moderates both inputs to and responses from LLMs", and "tools" is not among its supported
  # parameters. It classifies what another model wrote; no cascade below asks for that.
  # - model_name: nemotron-content-safety-free
  #   litellm_params:
  #     model: openrouter/nvidia/nemotron-3.5-content-safety:free
