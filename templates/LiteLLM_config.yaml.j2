# LiteLLM routing configuration, RENDERED by Ansible onto the managed node.
#
# No SPDX header: like the compose template, this is written onto the node rather than kept here.
#
# #2, v1 SCOPE: tigerblue77's own account only. Dragnix adds his own models later, from "/ui" himself
# -- his own decision, matching how he already runs every other self-hosted database of this estate
# (deployed empty, populated live). No entry below carries a "model_info.access_groups": every key
# reaches every model, on purpose -- a username has no more business being hardcoded into an
# authorization label than into a hostname, and there is only one account to isolate from so far
# anyway. What #2 asks beyond this -- "access_groups"-backed teams and virtual keys created by
# idempotent Ansible tasks against LiteLLM's admin API, per-key rpm/tpm limits, the "sci-*" / "gen-*"
# sensitivity split, and the executable cross-account negative test -- is real and still open, and
# deliberately NOT attempted here; when it lands, an account's identity has to come from a role
# variable, never from a name written into this template.
model_list:
  # ============================================================================
  # Virtual routers -- the names LibreChat and Claude Code actually ask for.
  # ============================================================================
  - model_name: pro
    litellm_params:
      model: gemini/gemini-3.7-flash
      api_key: "os.environ/GEMINI_API_KEY_TIGERBLUE77"

  - model_name: flash
    litellm_params:
      model: gemini/gemini-3.7-flash
      api_key: "os.environ/GEMINI_API_KEY_TIGERBLUE77"

  - model_name: flash-lite
    litellm_params:
      model: gemini/gemini-3.5-flash-lite
      api_key: "os.environ/GEMINI_API_KEY_TIGERBLUE77"

  - model_name: code
    litellm_params:
      model: gemini/gemini-3.7-flash
      api_key: "os.environ/GEMINI_API_KEY_TIGERBLUE77"

  # What issue #13's Claude Code agent actually asks for -- see its own compliance note: whatever
  # this resolves to must never be an Anthropic model backed by a subscription.
  - model_name: claude-code
    litellm_params:
      model: gemini/gemini-3.7-flash
      api_key: "os.environ/GEMINI_API_KEY_TIGERBLUE77"

  # ============================================================================
  # Google AI Studio (1M+ context, developer quota)
  # ============================================================================
  # GA 2026-09-02 per "ai.google.dev/gemini-api/docs/changelog", checked 2026-09-27 (this line said
  # 2026-09-13 until then). "ai.google.dev/gemini-api/docs/latest-model": "our most intelligent Flash
  # model, engineered for long-horizon software engineering, autonomous agents, and complex
  # enterprise workflows." Free of charge on the Standard tier per "ai.google.dev/gemini-api/docs/
  # pricing" -- verified directly against both pages, not assumed from the naming pattern alone.
  - model_name: gemini-3-8-flash
    litellm_params:
      model: gemini/gemini-3.8-flash
      api_base: "https://generativelanguage.googleapis.com/v1beta/openai/"
      api_key: "os.environ/GEMINI_API_KEY_TIGERBLUE77"

  - model_name: gemini-3-7-flash
    litellm_params:
      model: gemini/gemini-3.7-flash
      api_base: "https://generativelanguage.googleapis.com/v1beta/openai/"
      api_key: "os.environ/GEMINI_API_KEY_TIGERBLUE77"

  - model_name: gemini-3-6-flash
    litellm_params:
      model: gemini/gemini-3.6-flash
      api_base: "https://generativelanguage.googleapis.com/v1beta/openai/"
