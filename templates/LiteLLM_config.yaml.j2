router_settings:
  num_retries: 2
  retry_after: 2
  cooldown_time: 60
  allowed_fails: 1

  # Shares cooldown state between the "--num_workers" processes below: without it, each worker tracks
  # its own 429s independently, and a deployment can be considered healthy by one worker while another
  # has already cooled it down (#71).
  redis_host: "redis"
  redis_port: 6379
  redis_password: os.environ/REDIS_PASSWORD

  # Every cascade below stays inside tigerblue77's own keys, end to end -- there is only one account
  # in this file for v1 (see the note at the top), so there is nothing yet for a cascade to cross.
  # "check_LiteLLM_account_isolation.py" (#32) is what keeps that true once a second account's models
  # land here.
  fallbacks:
    # 1. PRO -- pure reasoning, multi-step logic, architecture.
    # Priority: Google Pro/Reasoning -> OpenRouter heavy -> Mistral Large -> Cerebras -> DeepSeek
    # direct (#101, paid -- last resort before the fully free OmniRoute) -> OmniRoute. GitHub Models
    # dropped from this chain by #109: retired 2026-07-30, see the model_list comment above.
    - pro:
        - gemini-3-1-pro
        - gemini-3-1-pro-customtools
        - gemini-2-5-pro
        - deep-research-pro
        - nemotron-ultra-free
        - mistral-large
        - glm-5-2-free
        - nemotron-reasoning-free
        - minimax-m3-free
        - gpt-oss-120b-cerebras
        - deepseek-v4-pro-direct
        - omniroute-free-reasoning

    # 2. FLASH -- balanced daily driver.
    # Priority: Google Flash (1M) -> LPUs (Cerebras/Groq) -> Mistral -> OpenRouter -> DeepSeek direct
    # (#101, paid -- last resort before the fully free OmniRoute) -> OmniRoute. GitHub Models dropped
    # from this chain by #109: retired 2026-07-30, see the model_list comment above.
    - flash:
        - gemini-3-6-flash
        - gemini-3-5-flash
        - gemini-3-flash-preview
        - gemini-omni-1-1-flash
        - gpt-oss-120b-cerebras
        - gpt-oss-120b-groq
        - qwen3-8-27b-groq
        - compound-groq
        - mistral-small
        - nemotron-super-free
        - gemma-4-31b-free
        - minimax-m2-7-free
        - openrouter-auto-free
        - deepseek-flash-direct
        - omniroute-free-auto

    # 3. FLASH-LITE -- atomic micro-tasks (<300ms). Accepts short-context (4k-32k) models for
    # ultra-high speed.
    - flash-lite:
        - gemini-3-1-flash-lite
        - gemini-2-5-flash-lite
        - gpt-oss-20b-groq
        - compound-mini-groq
        - qwen3-6-27b-groq
        - gemma-4-26b-free
        - nemotron-lightning-free
        - ling-flash-free
        - inkling-small-free
        - dots-note-free
        - poolside-laguna-xs-free
        - lfm-free

    # 4. CODE -- refactoring, Ansible playbooks, Bash/Python scripts. Excludes FIM (raw token) models.
    # Priority: syntax/code specialists -> DeepSeek direct (#101, paid -- last resort before the fully
    # free OmniRoute) -> OmniRoute. GitHub Models dropped from this chain by #109: retired 2026-07-30,
    # see the model_list comment above.
    - code:
        - codestral
        - codestral-2508
