general_settings:
  # The master key and the database URL are read from the environment rather than written here: this
  # file is mounted read-only into the container and would otherwise carry both in clear text.
  master_key: os.environ/LITELLM_MASTER_KEY
  database_url: os.environ/DATABASE_URL
  redis_url: os.environ/REDIS_URL

litellm_settings:
  request_timeout: 120          # long enough for heavy reasoning (R1 / o3-mini / deep-research)
  telemetry: false               # no outbound telemetry
  drop_params: true              # silently drops hyperparameters a given model does not support
  modify_params: true            # translates tool-call schemas between Anthropic and OpenAI/Gemini
  stream_timeout: 120            # extended timeout for models' reasoning phase
  force_ipv4: true               # avoids slow IPv6 resolution on the target VM
  stream_response_threshold: 0   # flushes SSE chunks to the client immediately
  # Keep the gateway's own logging free of prompt and response bodies. The corpus this estate routes
  # includes third-party legal documents, and a debug log is a copy of them nobody decided to keep.
  turn_off_message_logging: true

  # Response caching, to preserve the free tiers' TPM quotas (#71). Upstream documents proxy-level
  # caching as key/team/org-scoped by default, which would mean a cached answer never crosses an
  # account boundary -- but that scoping is NOT verified from this session (no Docker daemon to test
  # against), and #71's own Definition of Done says so explicitly. Confirm it on the test bench
  # before trusting it: this is exactly the kind of guarantee #2 exists to hold accountable.
  enable_caching: true
  cache_params:
    type: "redis"
    supported_call_types: ["completion", "cache_read", "cache_write"]
