# LiteLLM routing configuration, RENDERED by Ansible onto the managed node.
#
# No SPDX header: like the compose template, this is written onto the node rather than kept here.
#
# #2, v1 SCOPE: one account only. Another account's models come later, as entries of its own
# carrying keys of its own (#107) -- not from its "/ui" login, which LiteLLM does not let add a
# model. No entry below carries a "model_info.access_groups": every key
# reaches every model, on purpose -- a username has no more business being hardcoded into an
# authorization label than into a hostname, and there is only one account to isolate from so far
# anyway. What #2 asks beyond this -- "access_groups"-backed teams and virtual keys created by
# idempotent Ansible tasks against LiteLLM's admin API, per-key rpm/tpm limits, the "sci-*" / "gen-*"
# sensitivity split, and the executable cross-account negative test -- is real and still open, and
# deliberately NOT attempted here; when it lands, an account's identity has to come from a role
# variable, never from a name written into this template.
# #296: only the providers whose key the caller gives are rendered. A provider without a key has no
# entry below and no slot in any cascade: a model listed that cannot answer would be tried, fail, and
# only then hand the request on.
{% set has = {
  'Gemini': Artificial_Intelligence_LiteLLM_Gemini_API_key is string and Artificial_Intelligence_LiteLLM_Gemini_API_key | length > 0,
  'Mistral': Artificial_Intelligence_LiteLLM_Mistral_API_key is string and Artificial_Intelligence_LiteLLM_Mistral_API_key | length > 0,
  'Groq': Artificial_Intelligence_LiteLLM_Groq_API_key is string and Artificial_Intelligence_LiteLLM_Groq_API_key | length > 0,
  'OpenRouter': Artificial_Intelligence_LiteLLM_OpenRouter_API_key is string and Artificial_Intelligence_LiteLLM_OpenRouter_API_key | length > 0,
  'DeepSeek': Artificial_Intelligence_LiteLLM_DeepSeek_API_key is string and Artificial_Intelligence_LiteLLM_DeepSeek_API_key | length > 0
} %}
# The five routers below are aliases, whatever the keys: each stands for the first model of its own cascade
# that has a key, so that the order of a cascade alone decides and no provider is placed first by the way
# the names are built (the proxy accepts a name only if it is a model_list entry or an alias, so a router
# that exists as a cascade alone would be refused). A router is left out when no model of its cascade has
# a key. "check_compose_template.py" renders every non-empty set of keys and holds each alias to the first
# member of its cascade.
{% set head = {
  'pro': 'gemini-3-8-flash' if has.Gemini else 'nemotron-ultra-free' if has.OpenRouter else 'deepseek-v4-pro-direct' if has.DeepSeek else 'omniroute-free-reasoning',
  'flash': 'gemini-3-8-flash' if has.Gemini else 'gpt-oss-120b-groq' if has.Groq else 'mistral-small' if has.Mistral else 'gemma-4-31b-free' if has.OpenRouter else 'deepseek-flash-direct' if has.DeepSeek else 'omniroute-free-auto',
  'flash-lite': 'gemini-3-1-flash-lite' if has.Gemini else 'ministral-3b' if has.Mistral else 'gpt-oss-20b-groq' if has.Groq else 'gemma-4-26b-free' if has.OpenRouter else false,
  'code': 'gemini-3-8-flash' if has.Gemini else 'qwen3-8-27b-groq' if has.Groq else 'codestral' if has.Mistral else 'deepseek-v4-pro-direct' if has.DeepSeek else 'omniroute-free-code',
  'claude-code': 'gemini-3-8-flash' if has.Gemini else 'codestral' if has.Mistral else 'deepseek-v4-pro-direct' if has.DeepSeek else false
} %}
# Every name below stands for a router and has, under its own name, the router's cascade (#300): LiteLLM
# looks for fallbacks under the name that was ASKED for, so a request made under an alias that has no
# cascade of its own would not fall back at all. There is no alias for the names the Claude Code CLI sends
# by default: a CLI that should use one of these routers is told its name through its own model variables.
{% set aliases_of = {
  'pro': ['auto-pro'],
  'flash': ['auto', 'auto-flash', 'auto-fast'],
  'flash-lite': ['auto-flash-lite'],
  'code': ['auto-code'],
  'claude-code': []
} %}
model_list:
