        - mistral-large-4-nvidia
{% endif %}
{% if has.Groq %}
        - qwen3-8-27b-groq
{% endif %}
{% if has.Gemini %}
        - gemini-3-6-flash
{% endif %}
{% if has.NVIDIA %}
        - muse-glimmer-nvidia
{% endif %}
{% if has.Gemini %}
{% endif %}
{% if has.NVIDIA %}
        - laguna-xs-2-1-nvidia
{% endif %}
{% if has.Cloudflare %}
        - glm-4-7-flash-cloudflare
{% endif %}
{% if has.Zai %}
        - glm-4-7-flash-zai
{% endif %}
{% if has.Zai %}
        - glm-4-5-flash-zai
{% endif %}
{% if has.Cloudflare %}
        - phonellm-mini-alpha-2-cloudflare
{% endif %}
{% if has.Cloudflare %}
        - qwen3-8-27b-cloudflare
{% endif %}
{% if has.Mistral %}
        - codestral
        - codestral-2508
{% endif %}
{% if has.DeepSeek %}
        - deepseek-v4-pro-direct
{% endif %}
{% endif %}

    # 6. STT -- speech to text, for "/audio/transcriptions". Not ranked by a script and held to no
    # contract: its order is set by hand. Accuracy first, per Groq's own table of word error rates
    # ("console.groq.com/docs/speech-to-text", read 2026-11-22): "whisper-large-v3", then
    # "whisper-large-v3-turbo", which has its own quota and a higher rate. Gemini's free transcription
    # model comes next, ahead of the paid one because it costs nothing, behind Groq because of what its
    # free tier does with the audio (see its entry above). Mistral's Voxtral is last because it is paid.
{% if head['stt'] %}
    - Auto-STT:
{% if has.Groq %}
        - whisper-large-v3-groq
        - whisper-large-v3-turbo-groq
{% endif %}
{% if has.Gemini %}
        - gemini-3-5-transcribe
{% endif %}
{% if has.Mistral %}
        - voxtral-mini-mistral
{% endif %}
{% endif %}

    # 7. TTS -- text to speech, for /audio/speech. Not ranked by a leaderboard and with no contract: no
    # ranking of speech models is read here, so the order is decided by hand. The fuller model comes
    # first and the lite one second, which is a model of its own and so, if Google counts the quota per
    # model (not checked), one that answers when the first is refused for quota. A text model never
    # belongs here and a speech model never belongs in a text cascade: "check_compose_template.py" holds
    # both, through "model_info.mode". Mistral's Voxtral is called by its entry's name and held by no cascade, for the reason given
    # above its entry. LiteLLM's own source, read 2026-11-22, applies "fallbacks" and
    # "model_group_alias" to /audio/speech as it does to chat, and a "response_format" other than "wav"
    # and "pcm", which Gemini cannot produce, is refused before any request leaves, so by both members alike.
{% if head['tts'] %}
    - Auto-TTS:
        - gemini-3-8-flash-tts
        - gemini-3-8-flash-lite-tts
{% endif %}

    # 8. DECISION -- Clef's typed decisions, for "/v1/systemone" and "/v1/decisions". Not ranked by a leaderboard
    # and with no contract, so the order is set by hand, and a fallback has to take every request its head takes,
    # so that switching to it is invisible to the caller. Clef Omni does: text and images like Clef, with
    # 64,000 tokens of context against Clef's 65,536. Clef Flash takes the same text and images but only 24,576
    # tokens, so it comes last: a request it cannot hold would have failed with nothing behind it anyway, and one it
    # can hold is answered instead of refused. Clef Omni is also called by name for a request that carries audio or
    # video, which Clef does not read.
{% if head['decision'] %}
    - Auto-Decision:
        - clef-cloudflare
        - clef-omni-cloudflare
        - clef-flash-cloudflare
{% endif %}

    # 9. EXTRACTION -- Clairic's typed extraction, for "/v1/extraction". Ordered by hand like the router above,
    # by the same rule: Clairic Flash takes the same fields, text, images and PDFs, and the same 65,536 tokens, so
    # it stands behind Clairic, whose earlier preview it is.
{% if head['extraction'] %}
    - Auto-Extraction:
        - clairic-cloudflare
        - clairic-flash-cloudflare
{% endif %}

    # 10. FICTION -- the role-play and fiction models of Aion Labs, and only those: no other router holds them and
    # no other model is in this one, so that the router follows its head into the "Fiction" group and no key without
    # that group reaches it. Not ranked by a leaderboard, no figure being read for any of them, so the order is set by hand,
    # the newest and largest first ("aion-3-5-aion-labs", with 262,144 tokens of context) and the smallest last
    # ("aion-rp-llama-3-1-8b-aion-labs", with 32,768).
{% if head['fiction'] %}
    - Auto-Fiction:
        - aion-3-5-aion-labs
        - aion-3-5-mini-aion-labs
        - aion-3-0-aion-labs
        - aion-3-0-mini-aion-labs
        - aion-2-0-aion-labs
        - aion-rp-llama-3-1-8b-aion-labs
{% endif %}

  # Transparent alias mappings.
  model_group_alias:
    # The routers are written out one by one and not in a loop: "check_LiteLLM_account_isolation.py"
    # reads this file without rendering it, and a name produced by a loop is invisible to it.
{% if head['pro'] %}
    "Auto-Pro": "{{ head['pro'] }}"
{% endif %}
{% if head['flash'] %}
    "Auto-Flash": "{{ head['flash'] }}"
{% endif %}
{% if head['flash-lite'] %}
    "Auto-Flash-Lite": "{{ head['flash-lite'] }}"
{% endif %}
{% if head['code'] %}
    "Auto-Code": "{{ head['code'] }}"
{% endif %}
{% if head['claude-code'] %}
    "Auto-Claude-Code": "{{ head['claude-code'] }}"
{% endif %}
{% if head['stt'] %}
    "Auto-STT": "{{ head['stt'] }}"
{% endif %}
{% if head['tts'] %}
    "Auto-TTS": "{{ head['tts'] }}"
{% endif %}
{% if head['decision'] %}
    "Auto-Decision": "{{ head['decision'] }}"
{% endif %}
{% if head['extraction'] %}
    "Auto-Extraction": "{{ head['extraction'] }}"
{% endif %}
{% if head['fiction'] %}
    "Auto-Fiction": "{{ head['fiction'] }}"
{% endif %}

general_settings:
  # The master key and the database URL are read from the environment rather than written here: this
  # file is mounted read-only into the container and would otherwise carry both in clear text.
  master_key: os.environ/LITELLM_MASTER_KEY
  database_url: os.environ/DATABASE_URL
{% if Artificial_Intelligence_LiteLLM_disable_env_credential_login %}
  # "/ui" refuses "UI_USERNAME"/"UI_PASSWORD" and the master key: only a user stored in the database signs in.
  disable_env_credential_login: true
{% endif %}

litellm_settings:
  request_timeout: 120          # long enough for heavy reasoning models' thinking phase
  telemetry: false               # no outbound telemetry
  drop_params: true              # silently drops hyperparameters a given model does not support
  modify_params: true            # translates tool-call schemas between Anthropic and OpenAI/Gemini
  force_ipv4: true              # avoids slow IPv6 resolution on the target VM
  stream_response_threshold: 0   # flushes SSE chunks to the client immediately
  # Keep the gateway's own logging free of prompt and response bodies. The corpus this estate routes
  # includes third-party legal documents, and a debug log is a copy of them nobody decided to keep.
  turn_off_message_logging: true

  # No response cache, on purpose (#79). The two lines that were here, "enable_caching" and a
  # "cache_params" block, meant nothing to LiteLLM, which turns its cache on for "cache: true" and for
  # no other key: it had never been on, and leaving the key out keeps it off.
  #
  # It should stay off. The exact cache's key holds the whole "messages" list and the request's
  # parameters, and nothing about the caller: measured 2026-09-26 on LiteLLM 1.100.0 with two virtual
  # keys, an identical request sent with key B came back from the cache filled by key A, and only the
  # semantic caches add the key, team and organisation. A chat client resends a history that differs
  # almost every turn, so it hardly ever hits; what is left to gain is a workflow repeating one
  # stateless prompt within a short TTL.
