# Artificial Intelligence stack.
#
# This file is RENDERED onto the managed node: what is read here is a template, what lands there is
# an ordinary compose file. It deliberately carries no SPDX header, and "REUSE.toml" declares it
# instead: the header would end up copied into the deployed file, which is not a source file of
# this repository.
#
# No format "version:": the key has been obsolete since Compose v2, and Swarm never read it.
#
# ! A value this file takes from a caller's variable is written through "| replace('$', '$$')".
# Compose and "docker stack deploy" both read the rendered file through their OWN "$VAR" / "${VAR}"
# interpolation, after Ansible is done with it, so a single "$" left in a secret is read as the start
# of one of their variables: replaced by whatever that holds in their environment -- usually nothing,
# with a mere warning -- or, after "${" and a character no name starts with, the whole file refused.
# "$$" is how a literal "$" is spelt to them. Measured with Compose v5.1.1: "sk-Ab$cd9" reached the
# container as "sk-Ab", "sk-Ab$HOME" as "sk-Ab/root", and "sk-Ab$$cd9" as "sk-Ab$cd9".
#
# ! And the result goes through "| to_json(ensure_ascii=False)", with no quotes of its own around it
# (#188). Inside a double-quoted YAML string a backslash starts an escape and a double quote ends the
# string, so a secret holding either was refused or silently rewritten. Measured with the same
# Compose and with "docker stack config": 'ab"cd' and 'ab\qcd' had the whole file refused, 'ab\tcd'
# reached the container with a tab in it, 'ab\x41cd' as "abAcd" and 'ab\\cd' with one backslash. A
# JSON string is a valid double-quoted YAML scalar with every one of those escaped. "ensure_ascii" is
# not optional: left at its default, "to_json" -- like Jinja's own "tojson" -- writes a character
# outside the Basic Multilingual Plane, an emoji, as a surrogate pair that Compose and Swarm both
# refuse the file for. Where the value is only part of a string -- a mount's "source:target:mode" --
# the whole string is serialised. "replace" comes first, and "to_json" leaves its "$$" alone.
#
# Written without either, deliberately: Docker object names, memory sizes,
# numbers and the time zone, whose own grammar has no "$", quote or backslash to escape, and the
# published network's definition, which is compose YAML the caller already writes as such. A LITERAL
# "$" typed into this template needs the "$$" by hand; there is none, and a "${VAR}" there would be a
# ".env" in disguise. "check_compose_template.py" renders the values it can find with a "$", quotes
# and backslashes in them, and refuses a single "$" as well as a value that does not arrive whole:
# those with no default or an empty one by itself, those with a real default only once its
# "FREE_FORM_WITH_A_DEFAULT" names them. Where a line still writes a value raw, its
# "DOLLAR_LEFT_TO_OTHER_PULL_REQUESTS" and "QUOTES_LEFT_TO_OTHER_PULL_REQUESTS" name the pull
# request that is rewriting that line.

# Each service issue adds its block here, on the commented model below, and its variables in
# "defaults/main.yml".
services:

  # ------------------------------------------------------------------------------------------------
  # PostgreSQL -- the gateway's store (#1). It holds the virtual keys, the teams and the usage
  # ledger, which is the entire reason the gateway runs with a database rather than in file mode.
  # ------------------------------------------------------------------------------------------------
  postgres:
    # A database, so pinned on purpose to the major its volume was initialised with: a major bump
    # lands on a layout the new image does not read and imposes a pg_dump / restore (the README's
    # "Monter PostgreSQL d'un majeur"), so it must never happen because a tag moved under us. Check the
    # major is one the Prisma schema of the running LiteLLM supports before raising it. The major only,
    # on the Debian image: the Alpine variant sorts text with another C library, so it would be one more
    # thing to keep unchanged on a volume for no gain.
    image: postgres:18

    # LiteLLM is NOT this cluster's superuser (#159). The image makes "POSTGRES_USER" the bootstrap
    # superuser, and that role can never lose the attribute ("The bootstrap superuser must have the
    # SUPERUSER attribute"), so LiteLLM gets a role of its own instead: LOGIN and nothing else, owner
    # of its database -- which, since PostgreSQL 15, also gives it that database's "public" schema,
    # owned by "pg_database_owner", and that is all Prisma's migrations need. As the superuser, a
    # pre-authenticated SQL injection through the gateway (LiteLLM had one in 2026) reached a shell in
    # this container through "COPY ... PROGRAM" and any file through "pg_read_file"; as this role,
    # both are refused.
    #
    # The role is created by an init script the image's entrypoint runs, and written here, by "sh",
    # just before handing over to that entrypoint -- which "exec" keeps as PID 1, signals included.
    # Not a mounted file: a bind mount needs its host path on whichever node runs the task, and
    # "/tmp", this role's default directory, does not keep a file (#137). Not "configs.content"
    # either: Compose reads it, "docker stack" refuses it ("Additional property content is not
    # allowed"). The script holds no secret and no "$": "\getenv" reads both values from the
    # environment below, and psql's ":'...'" and ':"..."' quote them, whatever they contain.
    #
    # ! PostgreSQL 15 AT LEAST, and nothing but the pin on the "image:" line above keeps it so -- the
    # major is written in this file, not in a variable, so nothing checks it: "\getenv" is new in
    # psql 15, and so is a "public" schema owned by "pg_database_owner". On 14 the first boot stops
    # on "invalid command \getenv" once the data directory is already initialised; every restart
    # then skips the init scripts and serves a healthy-looking cluster with no role LiteLLM can log
    # in as, and only removing the volume undoes it.
    #
    # ! The image runs "/docker-entrypoint-initdb.d/" on an EMPTY data directory only. On a volume
    # initialised before this, nothing below runs: LiteLLM keeps its old superuser role and keeps
    # working. The README's "Un volume créé avant le rôle dédié de LiteLLM" gives the way across.
    #
    # "tcp_keepalives_idle=300": Swarm's service address is IPVS, which forgets a connection after
    # 900 s without a packet, and LiteLLM keeps pooled connections that sit idle longer than that. A
    # forgotten one is dead without either end knowing: the next query on it waits out TCP's
    # retransmissions before failing. A keepalive every five minutes keeps the address's entry alive.
    # Measured on a Swarm: idle through the service address, a connection survived 600 s and was lost
    # at 960 s; idle straight to the task, it survived 960 s. Under Compose there is no IPVS, and the
    # setting costs a probe every five minutes on an idle connection.
    command:
      - "sh"
      - "-c"
      - |
        cat > /docker-entrypoint-initdb.d/10_LiteLLM_role.sql <<'EOF'
        \getenv role POSTGRES_LITELLM_USER
        \getenv password POSTGRES_LITELLM_PASSWORD
        \getenv database POSTGRES_DB
        CREATE ROLE :"role" WITH LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS PASSWORD :'password';
        ALTER DATABASE :"database" OWNER TO :"role";
        EOF
        exec docker-entrypoint.sh postgres -c tcp_keepalives_idle=300

    environment:
      TZ: "{{ Artificial_Intelligence_server_time_zone }}"
      # Interpolated by ANSIBLE, at render time -- not by Compose from a ".env" it would otherwise
      # need in the project directory. It is what lets the same template serve Compose and Swarm
      # unchanged: Ansible renders this file the same way regardless of which one reads it next. The
      # literal value never appears anywhere else -- it is why the caller's deployment role has to
      # write THIS file "0600" and with "diff: false".
      POSTGRES_DB: {{ Artificial_Intelligence_PostgreSQL_database | replace('$', '$$') | to_json(ensure_ascii=False) }}
      # The cluster's superuser, and nothing connects as it: it exists for the init above and for a
      # human at "docker exec ... psql". Its password is not LiteLLM's -- "tasks/main.yml" refuses the
      # same value for both, or LiteLLM's own environment would hold the superuser's login.
      #
      # "$" is doubled in every value added here, because Compose and Swarm both run this file
      # through their own "${VAR}" interpolation after Ansible has rendered it.
      POSTGRES_USER: {{ Artificial_Intelligence_PostgreSQL_superuser | replace('$', '$$') | to_json(ensure_ascii=False) }}
      POSTGRES_PASSWORD: {{ Artificial_Intelligence_PostgreSQL_superuser_password | replace('$', '$$') | to_json(ensure_ascii=False) }}
      # LiteLLM's own role, the one "DATABASE_URL" logs in as. Read by the init script above, and only
      # there: the entrypoint unsets every "POSTGRES_*" before it starts the server.
      POSTGRES_LITELLM_USER: {{ Artificial_Intelligence_PostgreSQL_user | replace('$', '$$') | to_json(ensure_ascii=False) }}
      POSTGRES_LITELLM_PASSWORD: {{ Artificial_Intelligence_PostgreSQL_password | replace('$', '$$') | to_json(ensure_ascii=False) }}

    volumes:
      # A NAMED volume, not a bind mount: surviving a container recreation is an acceptance criterion
      # of #1, not a hope. A bind mount would also tie the stack to a host path, which this
      # repository does not get to choose.
      #
      # ! Its TARGET follows the major pinned above, because the official image moved its data directory at 18
      #   (docker-library/postgres#1259). Up to 17, PGDATA is "/var/lib/postgresql/data" and that is
      #   the image's volume. From 18, PGDATA is "/var/lib/postgresql/18/docker" and the volume is
      #   "/var/lib/postgresql", one level up, so that a later "pg_upgrade --link" finds both majors'
      #   clusters inside a single mount. A volume still mounted at ".../data" under 18 is not merely
      #   left unused: the entrypoint refuses it as an "unused mount/volume" and exits 1, on an EMPTY
      #   volume on a fresh machine too -- measured with "postgres:18-alpine" (#168).
      #
      #   The pin is 18, so the target is the "/var/lib/postgresql" one. Lowering the pin to 17 or
      #   earlier, or raising it past a major that moves the directory again, means changing this
      #   target in the same commit. A volume that already holds another major's cluster is refused at
      #   either path, by the image itself: raising the major on one is a migration, spelt out in the
      #   README.
      - "{{ Artificial_Intelligence_PostgreSQL_data_Docker_volume_name }}:/var/lib/postgresql:rw"

    healthcheck:
      # "pg_isready" ships with the image, so this needs nothing the container does not already have.
      #
      # ! Over TCP, on the port "DATABASE_URL" below names -- never over the Unix socket, which is
      #   what "pg_isready" picks without "-h". On a first boot the image initialises the store on a
      #   TEMPORARY server started with "listen_addresses=''", the socket only, then stops it and
      #   starts the real one. The socket probe answers "accepting connections" all through that
      #   window, while port 5432 still refuses every other container (#153). Measured with the
      #   window held open for 20 s: healthy at 5 s, TCP open at 21 s, and a container gated on
      #   "service_healthy" started in between and found nothing. "127.0.0.1" rather than
      #   "localhost", so the probe does not depend on what that name resolves to.
      #
      #   The price: the probe now FAILS for the whole of a first init. "start_period" (not counted)
      #   plus "retries" x "interval" is about 35 s before "unhealthy", against 1.5 to 2 s measured
      #   for an ordinary first boot. Swarm replaces an unhealthy task, so an init that ever gets
      #   near that budget -- a slow disk, an init script -- needs a longer "start_period", which
      #   costs nothing on the happy path: a success during it counts at once.
      #
      # The user and the database are interpolated by ANSIBLE, at render time, rather than by the
      # shell inside the container. Both forms work; this one has no shell to be right about -- the
      # "$$" in the "replace" below is for Compose, as on every caller value (see this file's header),
      # not for a shell. Neither value is a secret -- they are ordinary defaults of this role -- so
      # writing them into the rendered file costs nothing, and "CMD" without a shell is one less
      # thing between the probe and its answer.
      test: ["CMD", "pg_isready", "-h", "127.0.0.1", "-p", "5432", "-U", {{ Artificial_Intelligence_PostgreSQL_user | replace('$', '$$') | to_json(ensure_ascii=False) }}, "-d", {{ Artificial_Intelligence_PostgreSQL_database | replace('$', '$$') | to_json(ensure_ascii=False) }}]
      interval: 5s
      timeout: 5s
      start_period: 10s
      retries: 5

    deploy:
      restart_policy:
        # "any", never "on-failure": the orchestrator stops an unhealthy container cleanly, so the
        # process exits 0, and "on-failure" never replaces a task that exited cleanly.
        condition: any
      update_config:
        # Swarm only (Compose ignores it): a failed update goes back to the previous image instead of
        # leaving the service paused on the broken one.
        failure_action: rollback
{% if Artificial_Intelligence_PostgreSQL_memory_limit is string %}
      resources:
        limits:
          memory: "{{ Artificial_Intelligence_PostgreSQL_memory_limit }}"
{% endif %}

    networks:
      - {{ Artificial_Intelligence_internal_Docker_network_name }}

  # ------------------------------------------------------------------------------------------------
  # Redis -- LiteLLM's shared cooldown state between workers (#71). Not a response cache: that stays
  # off, since LiteLLM's exact cache answers one account from another's (#79, see the note at the
  # bottom of "LiteLLM_config.yaml.j2").
  # ------------------------------------------------------------------------------------------------
  redis:
    # Floating, with no tag at all (no tag IS "latest"): it holds only a cooldown state here, rebuilt
    # on its own after a restart, so nothing is lost when the major moves.
    image: redis

    # The password IS on the server's command line. What that exposes is "docker inspect", which also
    # shows every environment variable of this file, so nothing past what root and the "docker" group
    # can already read: Redis rewrites its own process title ("redis-server *:6379"), so the host's
    # "ps" does not show it. Moving it out would mean starting the server through a shell, which
    # bypasses the image entrypoint's drop to the "redis" user -- a worse trade than the one it fixes.
    command:
      - "redis-server"
      - "--requirepass"
      - {{ Artificial_Intelligence_Redis_password | replace('$', '$$') | to_json(ensure_ascii=False) }}
      - "--save"
      - "60"
      - "1"
      - "--loglevel"
      - "warning"

    volumes:
      - "{{ Artificial_Intelligence_Redis_data_Docker_volume_name }}:/data:rw"

    # Read by "redis-cli" on its own, which keeps the password off the healthcheck's command line
    # below: "redis-cli -a <password>" ran every ten seconds as a process any account of the host
    # could read the arguments of -- unlike the server's.
    environment:
      REDISCLI_AUTH: {{ Artificial_Intelligence_Redis_password | replace('$', '$$') | to_json(ensure_ascii=False) }}

    healthcheck:
      # "redis-cli" ships with the image, so this needs nothing it does not already have -- unlike
      # Qdrant (#3) or OmniRoute (#73), where the same reasoning ruled a healthcheck OUT instead.
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      start_period: 10s
      retries: 5

    deploy:
      restart_policy:
        condition: any
      update_config:
        # Swarm only: see the note on "postgres".
        failure_action: rollback
{% if Artificial_Intelligence_Redis_memory_limit is string %}
      resources:
        limits:
          memory: "{{ Artificial_Intelligence_Redis_memory_limit }}"
{% endif %}

    networks:
      - {{ Artificial_Intelligence_internal_Docker_network_name }}

  # ------------------------------------------------------------------------------------------------
  # LiteLLM Proxy -- the single point every LLM call of the estate goes through (#1).
  #
  # This container holds the Gemini / Groq / Mistral keys of BOTH accounts plus the master key. It is
  # the most sensitive component of the stack, which is exactly why its published port is not left
  # open behind nothing: its API answers only to a key -- the master key or a virtual one -- and "/ui"
  # only after a login through its own form, the admin's being "UI_USERNAME" / "UI_PASSWORD" below.
  # That login is a form and a session cookie, not HTTP basic auth, and none of it is TLS: see
  # "Artificial_Intelligence_LiteLLM_UI_password" in "defaults/main.yml".
  # ------------------------------------------------------------------------------------------------
  litellm:
    # Floating, with no tag at all (no tag IS "latest"): it keeps no state of its own, which lives in
    # PostgreSQL. Never write one for it, least of all upstream's deprecated "main-latest", which is
    # no longer fed and would freeze the deployment on an old image while looking current.
    image: ghcr.io/berriai/litellm
    environment:
      TZ: "{{ Artificial_Intelligence_server_time_zone }}"
      # The key everything "STORE_MODEL_IN_DB" below keeps in PostgreSQL is encrypted with -- the
      # provider keys added from "/ui" first of all (#164). Without it LiteLLM falls back to the master
      # key, and rotating the master key would make every stored credential unreadable. It never
      # changes once one is stored, and it differs from the master key; "defaults/main.yml" says why.
      LITELLM_SALT_KEY: {{ Artificial_Intelligence_LiteLLM_salt_key | replace('$', '$$') | to_json(ensure_ascii=False) }}
      # "postgres" is the SERVICE KEY declared above -- that is what Docker resolves in DNS. A
      # container_name would work under Compose and break under Swarm, which names its own tasks.
      #
      # This URL and the master key below are interpolated by Ansible, like every other secret of this
      # block -- see the note on "POSTGRES_PASSWORD" above. LiteLLM itself still reads both from ITS OWN
      # container environment, at the "os.environ/..." references "LiteLLM_config.yaml.j2" carries for
      # them: what Ansible changes is where that environment variable gets
      # its value from, never how LiteLLM consumes it.
      #
      # ! The user and the password are PERCENT-ENCODED, which a URL needs and the raw values do not give
      # it: a "/", "?" or "#" -- "/" is in the base64 alphabet -- ends the authority early, and Prisma
      # then refuses the whole string (P1013) so LiteLLM never starts; a ":" breaks the user, a "%" is
      # read as an escape in both. Jinja's "urlencode" leaves "/" alone, hence the "replace".
      #
      # ! The database is NOT encoded, because Prisma does not decode it: encoded here, a name holding
      #   "/", "?" or "#" made LiteLLM create and migrate a second database named after the encoded
      #   string, report healthy, and leave "POSTGRES_DB" empty. A name that needs encoding cannot
      #   reach Prisma intact in any form, so "tasks/main.yml" refuses one; what it lets through needs
      #   only its "$" doubled, as everywhere in this file. The encoded parts hold no "$" ("%24").
      DATABASE_URL: {{ ('postgresql://' ~ (Artificial_Intelligence_PostgreSQL_user | urlencode | replace('/', '%2F')) ~ ':' ~ (Artificial_Intelligence_PostgreSQL_password | urlencode | replace('/', '%2F')) ~ '@postgres:5432/' ~ Artificial_Intelligence_PostgreSQL_database) | replace('$', '$$') | to_json(ensure_ascii=False) }}
      # Administration only, from Ansible. It is NEVER handed to a consumer: every client gets its
      # own virtual key with its own model allow-list (#2). A client holding this key makes the whole
      # isolation work of #2 pointless.
      LITELLM_MASTER_KEY: {{ Artificial_Intelligence_LiteLLM_master_key | replace('$', '$$') | to_json(ensure_ascii=False) }}
      STORE_MODEL_IN_DB: "True"
      # The admin's own "/ui" login; each internal user has a restricted one of its own (#103). See
      # the note on "Artificial_Intelligence_LiteLLM_UI_password" in "defaults/main.yml". Basic auth
      # in front of it is what "ports:" below gives up by existing: it does not replace TLS, but it
      # is not nothing.
      UI_USERNAME: {{ Artificial_Intelligence_LiteLLM_UI_username | replace('$', '$$') | to_json(ensure_ascii=False) }}
      UI_PASSWORD: {{ Artificial_Intelligence_LiteLLM_UI_password | replace('$', '$$') | to_json(ensure_ascii=False) }}
      # The gateway account's provider keys (#2, v1 scope) -- read by "LiteLLM_config.yaml.j2" as
      # "os.environ/<PROVIDER>_API_KEY". Another account's are not here yet: they arrive the same
      # way, as routing entries of its own with keys of its own (#107).
      GEMINI_API_KEY: {{ Artificial_Intelligence_LiteLLM_Gemini_API_key | replace('$', '$$') | to_json(ensure_ascii=False) }}
      GITHUB_API_KEY: {{ Artificial_Intelligence_LiteLLM_GitHub_API_key | replace('$', '$$') | to_json(ensure_ascii=False) }}
      MISTRAL_API_KEY: {{ Artificial_Intelligence_LiteLLM_Mistral_API_key | replace('$', '$$') | to_json(ensure_ascii=False) }}
      CEREBRAS_API_KEY: {{ Artificial_Intelligence_LiteLLM_Cerebras_API_key | replace('$', '$$') | to_json(ensure_ascii=False) }}
      GROQ_API_KEY: {{ Artificial_Intelligence_LiteLLM_Groq_API_key | replace('$', '$$') | to_json(ensure_ascii=False) }}
      OPENROUTER_API_KEY: {{ Artificial_Intelligence_LiteLLM_OpenRouter_API_key | replace('$', '$$') | to_json(ensure_ascii=False) }}
      DEEPSEEK_API_KEY: {{ Artificial_Intelligence_LiteLLM_DeepSeek_API_key | replace('$', '$$') | to_json(ensure_ascii=False) }}
      CLOUDFLARE_API_KEY: {{ Artificial_Intelligence_LiteLLM_Cloudflare_API_key | replace('$', '$$') | to_json(ensure_ascii=False) }}
      # No entry names this one: LiteLLM's "cloudflare/" provider reads it from its environment to build the
      # address of the endpoint, which carries the account's identifier.
      CLOUDFLARE_ACCOUNT_ID: {{ Artificial_Intelligence_LiteLLM_Cloudflare_account_ID | replace('$', '$$') | to_json(ensure_ascii=False) }}
      # The one entry that cannot let LiteLLM build the address (its "cloudflare/" provider has no embedding
      # route), so the address is built here and read whole as that entry's "api_base".
      CLOUDFLARE_EMBEDDINGS_API_BASE: {{ ('https://api.cloudflare.com/client/v4/accounts/' ~ Artificial_Intelligence_LiteLLM_Cloudflare_account_ID ~ '/ai/v1' if Artificial_Intelligence_LiteLLM_Cloudflare_account_ID | length > 0 else '') | replace('$', '$$') | to_json(ensure_ascii=False) }}
      ZAI_API_KEY: {{ Artificial_Intelligence_LiteLLM_Zai_API_key | replace('$', '$$') | to_json(ensure_ascii=False) }}
      REQUESTY_API_KEY: {{ Artificial_Intelligence_LiteLLM_Requesty_API_key | replace('$', '$$') | to_json(ensure_ascii=False) }}
      NVIDIA_NIM_API_KEY: {{ Artificial_Intelligence_LiteLLM_NVIDIA_API_key | replace('$', '$$') | to_json(ensure_ascii=False) }}
      CENT_AI_API_KEY: {{ Artificial_Intelligence_LiteLLM_Cent_AI_API_key | replace('$', '$$') | to_json(ensure_ascii=False) }}
      AION_LABS_API_KEY: {{ Artificial_Intelligence_LiteLLM_Aion_Labs_API_key | replace('$', '$$') | to_json(ensure_ascii=False) }}
      # The workers' shared cooldown state (#71) reaches Redis through "router_settings" in
      # "LiteLLM_config.yaml.j2" -- "redis_host", "redis_port", and this as "redis_password".
      # No REDIS_URL any more: the response cache it was also meant for stays off (#79), its key
      # ignoring the caller, and nothing else reads it -- LiteLLM drops it once a host is named.
      REDIS_PASSWORD: {{ Artificial_Intelligence_Redis_password | replace('$', '$$') | to_json(ensure_ascii=False) }}

    configs:
      # A Docker config, not a bind mount: LiteLLM reads this file once, at start, and a changed routing
      # changes nothing else in this file -- which is all "docker compose up" and "docker stack deploy"
      # compare. The config's name carries the file's content (see "config_Docker_name" in
      # "defaults/main.yml"), so a changed file is a new name: Compose recreates the container and Swarm
      # updates the service, where a bind mount left it serving the old routing (#161). Read-only, as
      # configs are: the gateway reads its routing configuration, it does not rewrite it. #2 fills the
      # model list; what this role renders is the file and its general settings.
      - source: "{{ Artificial_Intelligence_LiteLLM_config_Docker_name }}"
        target: /app/config.yaml

    command:
      - "--config"
      - "/app/config.yaml"
      - "--port"
      - "4000"
      - "--num_workers"
      - "{{ Artificial_Intelligence_LiteLLM_number_of_workers }}"
      # A failed schema migration EXITS the container instead of being logged and walked past. Left
      # out -- upstream's default at v1.100.0 -- LiteLLM prints "Database migration failed but
      # continuing startup" and serves on whatever schema the database holds, typically the
      # previous tag's one when a tag bump brings a migration that errors out. "/health/liveliness"
      # and even "/health/readiness", which only tests the connection, answer 200 on it, so neither
      # the healthcheck below nor "restart_policy" ever acts: what breaks is whichever request first
      # reads what the migration should have created. Exiting hands the failure to
      # "restart_policy.condition: any" instead -- a restart loop and a red line in the logs, which
      # is what a migration that did not happen should look like (#163).
      #
      # The price: a transient failure restarts the container too, and the next start retries the
      # migrations, which is what that case needs anyway. A database that stays unreachable is not
      # what this is for: LiteLLM's own connection at startup already fails and exits then.
      #
      # The flag and the "ENFORCE_PRISMA_MIGRATION_CHECK" variable upstream's message names are one
      # and the same click option; the flag is written here, beside the other startup options.
      - "--enforce_prisma_migration_check"

    # Published, and this reverses #1's own original call -- see "Artificial_Intelligence_LiteLLM_UI_password" in
    # "defaults/main.yml" for why. "/ui" is where the admin and each internal user log in (#103), so
    # it has to be reachable with nothing more than a browser on the LAN, before the reverse proxy
    # this stack does not own exists to do it instead. The cost is real and is not waived by this
    # comment: no TLS, so the "/ui" login form (above) and the API's keys cross the LAN in clear text,
    # and they are all that stands between the LAN and the master key's container. Revisit the day a
    # reverse proxy is in front of it.
    ports:
      - "{{ Artificial_Intelligence_LiteLLM_port_to_expose }}:4000"

    healthcheck:
      # "/health" requires authentication; "/health/liveliness" does not. Written with the image's
      # own Python rather than curl, whose presence is NOT guaranteed in the image -- a healthcheck
      # calling a binary that is not there fails closed, and the service sits unhealthy for a reason
      # that has nothing to do with the service.
      test:
        - "CMD"
        - "python"
        - "-c"
        - "import urllib.request; urllib.request.urlopen('http://localhost:4000/health/liveliness').read()"
      interval: 30s
      timeout: 10s
      # The first run applies the Prisma migrations, which is the slow start this window covers.
      start_period: 90s
      retries: 3

    # The SHORT form, a plain list, and never the long one. Compose starts these two first, without
    # waiting for them to turn healthy; "docker stack deploy" accepts the list and ignores it. The
    # long form ("condition: service_healthy") is Compose-only: docker/cli validates this file
    # against its own schema, where "depends_on" is a list of strings, and refuses the WHOLE file
    # ("services.litellm.depends_on must be a list") before it reaches the daemon (#154). LiteLLM
    # therefore has to tolerate a database that is not answering yet, under either deployer: a first
    # start that fails is caught by "restart_policy.condition: any" below, not by the start order.
    depends_on:
      - postgres
      - redis

    deploy:
      restart_policy:
        condition: any
      update_config:
        # Swarm only: see the note on "postgres".
        failure_action: rollback
{% if Artificial_Intelligence_LiteLLM_memory_limit is string %}
      resources:
        limits:
          # Depends on "--num_workers": each worker replicates the configuration.
          memory: "{{ Artificial_Intelligence_LiteLLM_memory_limit }}"
{% endif %}

    networks:
      - {{ Artificial_Intelligence_internal_Docker_network_name }}

  # ------------------------------------------------------------------------------------------------
  # OmniRoute -- the gateway's keyless, free, last-resort fallback (#73). No provider key is ever
  # connected to it: it is deliberately shared between every account, since there is no quota behind
  # it to isolate. "check_LiteLLM_account_isolation.py" (#2) exempts it from the isolation rules for
  # exactly this reason.
  # ------------------------------------------------------------------------------------------------
  omniroute:
    # Floating, on the "-web" variant, which is the lean image plus Chromium and Playwright (the
    # "runner-web" stage of upstream's Dockerfile). The lean one cannot run "cfp", the Cloudflare
    # Playground provider, which is anonymous but drives a browser: its calls fail with "needs Playwright
    # and its Chromium browser" and every "auto" combo that reaches it answers nothing. Measured
    # 2026-11-22 on a throwaway container: the lean image answered none of the combos tried and this one
    # answered every one of them. The tag floats like "latest" does.
    image: diegosouzapw/omniroute:latest-web

    environment:
      TZ: "{{ Artificial_Intelligence_server_time_zone }}"
      # Overrides the image's own "CHANGEME" default, which upstream documents as deliberately weak
      # to force a change -- never left as-is, same standard as "Artificial_Intelligence_LiteLLM_UI_password" (#1).
      INITIAL_PASSWORD: {{ Artificial_Intelligence_OmniRoute_dashboard_password | replace('$', '$$') | to_json(ensure_ascii=False) }}
      # Keyless ON PURPOSE, and said here rather than left to the image: this is the account-agnostic
      # last resort some cascades end on (#2), and LiteLLM calls it with a placeholder key. The image
      # floats with no tag, so nothing holds its default still, and its Dockerfile sets
      # "ENV REQUIRE_API_KEY=true" (since 3.8.51), documenting "-e REQUIRE_API_KEY=false" as the
      # override for an intentionally keyless deployment. This line is that override: without it every
      # "omniroute-free-*" entry would be refused, with nothing showing the last rung of those cascades
      # had gone.
      REQUIRE_API_KEY: "false"

    volumes:
      # Named, at the path the upstream Docker guide's own example mounts: "/app/data".
      - "{{ Artificial_Intelligence_OmniRoute_data_Docker_volume_name }}:/app/data:rw"

    # Published, for the same reason as LiteLLM's "/ui" (#1): the dashboard needs to be reachable
    # from a browser on the LAN, and "INITIAL_PASSWORD" above is what stands in front of it.
    ports:
      - "{{ Artificial_Intelligence_OmniRoute_port_to_expose }}:20128"

    healthcheck:
      # No "curl" guaranteed in a Node.js image any more than in LiteLLM's -- written with the
      # runtime the image already has. "/livez" is the liveness endpoint the upstream Docker guide
      # documents.
      test:
        - "CMD"
        - "node"
        - "-e"
        - "require('http').get('http://localhost:20128/livez', r => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"
      interval: 30s
      timeout: 10s
      start_period: 30s
      retries: 3

    deploy:
      restart_policy:
        condition: any
      update_config:
        # Swarm only: see the note on "postgres".
        failure_action: rollback
{% if Artificial_Intelligence_OmniRoute_memory_limit is string %}
      resources:
        limits:
          memory: "{{ Artificial_Intelligence_OmniRoute_memory_limit }}"
{% endif %}

    networks:
      - {{ Artificial_Intelligence_internal_Docker_network_name }}

  # ------------------------------------------------------------------------------------------------
  # Qdrant -- the Artificial Intelligence stack's vector engine (#3). Deploy-only scope: the collections themselves need a
  # vector dimension, and that dimension comes from the embedding model #21 has not chosen yet --
  # creating one now would mean guessing it, which is exactly the silent RAG-pipeline breakage #3
  # warns against. This block gets the server running; #21 creates the collections once the model is
  # picked.
  # ------------------------------------------------------------------------------------------------
  qdrant:
    # A database, so pinned on purpose to its major: the vectors live only in its volume, and a major
    # change is a deliberate move made after a backup, not something a tag that moved should do.
    image: qdrant/qdrant:v1

    environment:
      TZ: "{{ Artificial_Intelligence_server_time_zone }}"
      QDRANT__SERVICE__API_KEY: {{ Artificial_Intelligence_Qdrant_API_key | replace('$', '$$') | to_json(ensure_ascii=False) }}

    volumes:
      - "{{ Artificial_Intelligence_Qdrant_data_Docker_volume_name }}:/qdrant/storage:rw"

    # No "ports:": #3 is explicit that Qdrant is reached only by other containers of the stack, over
    # the internal network -- unlike LiteLLM's "/ui" or OmniRoute's dashboard, nothing here is meant
    # for a human browser.

    # No "healthcheck:" here, deliberately, per the template's own model below ("only write one to do
    # better, not to do the same"): the official image ships neither a HEALTHCHECK of its own nor a
    # shell tool to call one with -- no "curl", no interpreter, by design (an intentional hardening
    # upstream, not an oversight). A "CMD" naming a binary that is not there would fail on every
    # single check, marking the service permanently unhealthy for a reason that has nothing to do
    # with Qdrant itself. "/livez" stays reachable unauthenticated for whoever adds one later once an
    # HTTP-capable sidecar exists to call it.

    deploy:
      restart_policy:
        condition: any
      update_config:
        # Swarm only: see the note on "postgres".
        failure_action: rollback
{% if Artificial_Intelligence_Qdrant_memory_limit is string %}
      resources:
        limits:
          memory: "{{ Artificial_Intelligence_Qdrant_memory_limit }}"
{% endif %}

    networks:
      - {{ Artificial_Intelligence_internal_Docker_network_name }}

  # ------------------------------------------------------------------------------------------------
  # LibreChat -- the Artificial Intelligence stack's human-facing chat interface (#76).
  # ------------------------------------------------------------------------------------------------
  librechat:
    # Floating, with no tag at all (no tag IS "latest"): it keeps no state of its own, which lives in
    # MongoDB below.
    image: ghcr.io/danny-avila/librechat
    # ! CONTAINER labels, so deliberately NOT under "deploy:" -- the one place in this file where that
    # is right. "deploy.labels" sets labels on the SERVICE object; "labels" sets them on the
    # CONTAINERS, and "docker compose up" and "docker stack deploy" both honour them there. That is
    # what makes them usable as a handle: "tasks/main.yml" has to find this container to run
    # "npm run create-user" inside it, a container NAME is part of no contract (Compose writes
    # "<project>-<service>-<n>", Swarm "<stack>_<service>.<n>.<task id>"), and the labels the
    # DEPLOYER writes are not the same either -- "com.docker.compose.*" under one,
    # "com.docker.swarm.*" under the other. A label this file writes itself is identical under both,
    # so the lookup needs no branch and the role stops depending on who deploys it.
    labels:
      artificial_intelligence.stack: "{{ Artificial_Intelligence_Docker_stack_name }}"
      artificial_intelligence.service: "librechat"

    environment:
      HOST: "0.0.0.0"
      PORT: "3080"
      MONGO_URI: "mongodb://librechat_mongodb:27017/LibreChat"
      # No shared virtual key here any more (#103): "librechat.yaml" reads "apiKey: \"user_provided\""
      # for the gateway endpoint, so LibreChat asks each of ITS OWN accounts for their own key the
      # first time they use it, rather than every account sharing whatever this env var once held.
      # Closed on purpose: the port below is on the LAN, and open registration there would hand
      # anyone on the network a seat on both accounts' quotas. See "defaults/main.yml".
      ALLOW_REGISTRATION: "{{ Artificial_Intelligence_LibreChat_allow_registration | string | lower }}"
      # See "Artificial_Intelligence_LibreChat_session_cookie_secure" in "defaults/main.yml": Secure
      # session cookies over plain HTTP are dropped by the browser, and every reload logs the account out.
      SESSION_COOKIE_SECURE: "{{ Artificial_Intelligence_LibreChat_session_cookie_secure | string | lower }}"
      # Without these four, LibreChat generates temporary values on first start and keeps them
      # nowhere but its own volume -- unsuitable for production by its own documentation.
      CREDS_KEY: {{ Artificial_Intelligence_LibreChat_creds_key | replace('$', '$$') | to_json(ensure_ascii=False) }}
      CREDS_IV: {{ Artificial_Intelligence_LibreChat_creds_IV | replace('$', '$$') | to_json(ensure_ascii=False) }}
      JWT_SECRET: {{ Artificial_Intelligence_LibreChat_JWT_secret | replace('$', '$$') | to_json(ensure_ascii=False) }}
      JWT_REFRESH_SECRET: {{ Artificial_Intelligence_LibreChat_JWT_refresh_secret | replace('$', '$$') | to_json(ensure_ascii=False) }}

    configs:
      # A Docker config named after its content, for the reason on "litellm" above: LibreChat reads
      # "librechat.yaml" at start only. Read-only: this is the Artificial Intelligence stack's copy,
      # not LibreChat's to rewrite.
      - source: "{{ Artificial_Intelligence_LibreChat_config_Docker_name }}"
        target: /app/librechat.yaml

    volumes:
      - "{{ Artificial_Intelligence_LibreChat_uploads_Docker_volume_name }}:/app/uploads:rw"

    # Published: this is the Artificial Intelligence stack's human-facing chat interface, same reasoning as LiteLLM's "/ui"
    # (#1) and OmniRoute's dashboard (#73). "ALLOW_REGISTRATION: false" above is what stands between
    # the LAN and an unauthenticated seat on both accounts' quotas.
    ports:
{% if Artificial_Intelligence_LibreChat_publish_in_host_mode %}
      - target: 3080
        published: {{ Artificial_Intelligence_LibreChat_port_to_expose }}
        protocol: tcp
        mode: host
{% else %}
      - "{{ Artificial_Intelligence_LibreChat_port_to_expose }}:3080"
{% endif %}

    healthcheck:
      # The image's own "node", never "curl": the LibreChat image carries no curl, so a probe calling
      # it would fail on every run and Swarm would replace a healthy task forever. "127.0.0.1" rather
      # than "localhost", which Node may resolve to "::1" first while LibreChat listens on IPv4 only.
      test:
        - "CMD"
        - "node"
        - "-e"
        - "require('http').get('http://127.0.0.1:3080/health', r => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"
      interval: 30s
      timeout: 10s
      # A success during it counts at once, so a long one costs nothing on the happy path.
      start_period: 60s
      retries: 3

    # Short form only -- see the note on "litellm"'s "depends_on" for why the long one is refused.
    depends_on:
      - librechat_mongodb

    deploy:
      restart_policy:
        condition: any
      update_config:
        # Swarm only: see the note on "postgres".
        failure_action: rollback
{% if Artificial_Intelligence_LibreChat_memory_limit is string %}
      resources:
        limits:
          memory: "{{ Artificial_Intelligence_LibreChat_memory_limit }}"
{% endif %}

    networks:
      - {{ Artificial_Intelligence_internal_Docker_network_name }}

  # ------------------------------------------------------------------------------------------------
  # MongoDB -- LibreChat's own store (#76). Reached only by LibreChat, over the internal network.
  # ------------------------------------------------------------------------------------------------
  librechat_mongodb:
    # A database, so pinned on purpose to its major: "8" takes every 8.x release as it ships, the way
    # PostgreSQL takes its minor ones. A later major is a move made by hand, through MongoDB's upgrade
    # procedure and its featureCompatibilityVersion step, never a moved tag.
    image: mongo:9
    # Same reason as the "librechat" service above -- see the note there rather than a second copy.
    labels:
      artificial_intelligence.stack: "{{ Artificial_Intelligence_Docker_stack_name }}"
      artificial_intelligence.service: "librechat_mongodb"

    healthcheck:
      # "mongosh" ships in the image, and "tasks/main.yml" already runs it against this container.
      test: ["CMD", "mongosh", "--quiet", "--eval", "db.adminCommand('ping')"]
      interval: 30s
      timeout: 30s
      start_period: 0s
      retries: 3

    environment:
      TZ: "{{ Artificial_Intelligence_server_time_zone }}"

    volumes:
      - "{{ Artificial_Intelligence_MongoDB_LibreChat_data_Docker_volume_name }}:/data/db:rw"

    deploy:
      restart_policy:
        condition: any
      update_config:
        # Swarm only: see the note on "postgres".
        failure_action: rollback
{% if Artificial_Intelligence_MongoDB_LibreChat_memory_limit is string %}
      resources:
        limits:
          memory: "{{ Artificial_Intelligence_MongoDB_LibreChat_memory_limit }}"
{% endif %}

    networks:
      - {{ Artificial_Intelligence_internal_Docker_network_name }}
{% if Artificial_Intelligence_Claude_code_enabled %}

  # ------------------------------------------------------------------------------------------------
  # Claude Code agent (#13). Deployed with the rest of the stack; the condition is the
  # caller's way to leave it out, for a deployment that has no use for it.
  # ------------------------------------------------------------------------------------------------
  claude_code:
    # Floats like the stack's other non-database images, written with no tag: the deployer pulls on
    # every run. Built and published by Dragnix-Tigerblue77/Claude-Code-Docker-container, which
    # follows npm's stable channel for Claude Code; nothing is built from this file (#226).
    image: ghcr.io/dragnix-tigerblue77/claude-code-docker-container

    # Kept open rather than run-and-exit: this is a CLI meant to be reached with "docker exec", not a
    # server, and Claude Code's own entrypoint would otherwise exit the moment it reads EOF on stdin.
    stdin_open: true
    tty: true

    environment:
      TZ: "{{ Artificial_Intelligence_server_time_zone }}"
      # Routed through the gateway (#1) on a MODEL ALIAS rather than a literal model name or
      # Anthropic's API directly -- #13's compliance point is that whatever this alias resolves to in
      # LiteLLM (#2) is never an Anthropic model backed by a subscription.
      ANTHROPIC_BASE_URL: "http://litellm:4000"
      ANTHROPIC_API_KEY: {{ Artificial_Intelligence_Claude_code_virtual_key | replace('$', '$$') | to_json(ensure_ascii=False) }}
      # Every variable Claude Code reads a model from carries the SAME alias (#287). Its background
      # requests (titles, summaries) go to the Haiku-class model and its subagents and aliases to
      # others, each under a name the agent's virtual key does not allow -- the key allows the alias
      # and the routers of "Artificial_Intelligence_Claude_code_additional_models" (#307) and no
      # other name, which is what keeps this container off the other accounts' quotas -- so the
      # gateway would refuse them. The cost is that all of it runs on the main model, unless a
      # router is chosen by name ("/model flash").
{% set Claude_code_model = Artificial_Intelligence_Claude_code_model | replace('$', '$$') | to_json(ensure_ascii=False) %}
{% for Claude_code_model_variable in ['ANTHROPIC_MODEL', 'ANTHROPIC_DEFAULT_HAIKU_MODEL', 'ANTHROPIC_DEFAULT_SONNET_MODEL', 'ANTHROPIC_DEFAULT_OPUS_MODEL', 'CLAUDE_CODE_SUBAGENT_MODEL'] %}
      {{ Claude_code_model_variable }}: {{ Claude_code_model }}
{% endfor %}
      # The alias resolves to a model Claude Code does not recognise by name, so its own context
      # window enforcement -- built around the models it DOES know -- has to be told what to allow
      # rather than refusing an unrecognised one outright.
      CLAUDE_CODE_MAX_CONTEXT_TOKENS: "1000000"
      CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT: "1"
{% if Artificial_Intelligence_Claude_code_GitHub_token is string %}
      # Only when the caller gives a token (#245). Claude Code reads both itself to call the GitHub API, for
      # its PR status footer among others, and the image has no "gh" to fall back on; a deployment that
      # would rather have no GitHub token in the container's environment gives none and loses the footer.
      GH_TOKEN: {{ Artificial_Intelligence_Claude_code_GitHub_token | replace('$', '$$') | to_json(ensure_ascii=False) }}
      GITHUB_TOKEN: {{ Artificial_Intelligence_Claude_code_GitHub_token | replace('$', '$$') | to_json(ensure_ascii=False) }}
{% endif %}

    volumes:
{% if Artificial_Intelligence_Claude_code_workspace_directory is string %}
      # The caller asked for a directory of its own: a bind mount, which this role does not create.
      - {{ (Artificial_Intelligence_Claude_code_workspace_directory | replace('$', '$$') ~ ':/workspace:rw') | to_json(ensure_ascii=False) }}
{% else %}
      # A named volume by default: nothing has to exist on the host before the first run. Docker fills
      # an empty one from the image's own "/workspace", which belongs to the "node" user.
      - "{{ Artificial_Intelligence_Claude_code_workspace_Docker_volume_name }}:/workspace:rw"
{% endif %}
      # The WHOLE home directory, "~/.claude.json" included -- see the note on
      # "Artificial_Intelligence_Claude_code_home_Docker_volume_name" in "defaults/main.yml" for why a volume
      # on "~/.claude" alone would silently lose half the session on every recreation.
      - "{{ Artificial_Intelligence_Claude_code_home_Docker_volume_name }}:/home/node:rw"

    # No "docker.sock" mount here: #11 has not yet designed the isolation an agent needs before it
    # can reach the host's Docker daemon, and this container waits for it rather than pre-empting it.

    # No "ports:": this is reached with "docker exec" and, later, through the MCP tool gateway (#7) --
    # never through a port published on the host.

    deploy:
      restart_policy:
        condition: any
      update_config:
        # Swarm only: see the note on "postgres".
        failure_action: rollback
{% if Artificial_Intelligence_Claude_code_memory_limit is string %}
      resources:
        limits:
          memory: "{{ Artificial_Intelligence_Claude_code_memory_limit }}"
{% endif %}

    # Short form only -- see the note on "litellm"'s "depends_on" for why the long one is refused.
    depends_on:
      - litellm

    networks:
      - {{ Artificial_Intelligence_internal_Docker_network_name }}
{% endif %}

{% raw %}
  # ------------------------------------------------------------------------------------------------
  # The model to copy. It describes no real service: it carries the conventions #31 sets, at the
  # place where they get forgotten.
  #
  # It is a fragment OF THIS TEMPLATE, not of the rendered file: it shows itself as it is typed,
  # Jinja expressions included. Hence the "raw" block around it, without which it would render each
  # variable's VALUE -- and "- False" for an unset published network.
  # ------------------------------------------------------------------------------------------------
  #
  # service_name:
  #   # Floating by default, written with NO tag (no tag IS ":latest", so ":latest" is never written
  #   # either): the deployer pulls on every run. A database whose data lives only in its own volume
  #   # is pinned instead, to its major, literally here, with the reason on the line above.
  #   # An image is pulled, never built here, so there is no "build:" key: Compose builds an image only
  #   # when none by that name exists and never compares it with its source.
  #   image: vendor/image
  #
  #   # Only for a service that reads, at start, a configuration file this role writes and mounts:
  #   # mount it as a Docker config named after the file's content, never as a bind mount in
  #   # "volumes:", where a changed file is invisible in this one and neither Compose nor Swarm
  #   # recreates the container that reads it. The task writing the file registers its result, and
  #   # "tasks/main.yml" passes ".checksum" to the deployment role as an "include_role" parameter,
  #   # "false" in "defaults/main.yml"; the name is derived from it there (#161).
  #   configs:
  #     - source: "{{ Artificial_Intelligence_service_config_Docker_name }}"
  #       target: /path/in/the/container
  #
  #   # Everything below lives under "deploy:", and that is deliberate: it is the only form BOTH
  #   # Compose and Swarm honour. "restart: unless-stopped", "mem_limit:" and "cpus:" work in Compose
  #   # and are IGNORED by Swarm -- silently, which is the worst of both worlds. Writing under
  #   # "deploy:" from the start means the move to Swarm does not reopen this file.
  #   deploy:
  #     restart_policy:
  #       # "any", never "on-failure". When a container turns unhealthy the orchestrator stops it
  #       # cleanly, the process exits 0, and "on-failure" never replaces a task that exited cleanly:
  #       # the service sits at 0 replicas, the reverse proxy stops building its router, and the URL
  #       # answers a bare 404 with nothing logged anywhere.
  #       condition: any
  #     update_config:
  #       # Swarm only, ignored by Compose: a failed update returns to the previous image rather than
  #       # leaving the service paused on the broken one.
  #       failure_action: rollback
  #     resources:
  #       limits:
  #         # Optional, and absent by default: the block is written under "if <variable> is string",
  #         # so a caller who sets no "<service>_memory_limit" (false) gets no limit, and one who sets
  #         # a size gets it. Without a limit, one container running away can take the others down
  #         # by OOM, which is the caller's trade-off to make.
  #         memory: 512M
  #
  #   # Only when the service needs another one started first, and then as a plain LIST of service
  #   # names. The long form, with a "condition:", is Compose-only: "docker stack deploy" refuses the
  #   # whole file over it, while "docker compose config" says nothing. Waiting for the other service
  #   # to be healthy is not something this file can ask for; the restart policy above catches a start
  #   # that came too early.
  #   depends_on:
  #     - other_service
  #
  #   # No "ports:" for an internal service: it is reached over the stack's network, under its
  #   # service name. Only a web interface meant for a human is exposed, and it goes through the
  #   # caller's reverse proxy -- never through a port published on the host.
  #   #
  #   # No "container_name:" either: Swarm ignores it, and a hostname that only exists under Compose
  #   # is a dependency that breaks at the moment of the switch.
  #   #
  #   # A host port that IS allocated must dodge Chromium's restricted list: a restricted port is
  #   # refused inside the browser, before the connection leaves it, so the service stays healthy and
  #   # its logs stay empty.
  #
  #   # The image often ships one, better than anything written here: Docker inherits it as long as
  #   # the service declares none. Only write one to do better, not to do the same.
  #   #
  #   # A probe asks the question the service's CONSUMERS ask: over the port they connect to, not
  #   # through a side door that opens earlier. PostgreSQL's socket answered while its port was
  #   # still closed to every other container (#153).
  #   healthcheck:
  #     test: ["CMD", "…"]
  #     interval: 30s
  #     timeout: 30s
  #     start_period: 10s
  #     retries: 3
  #
  #   environment:
  #     TZ: "{{ Artificial_Intelligence_server_time_zone }}"
  #     # A value the caller supplies -- a secret above all -- has its "$" doubled, because Compose
  #     # reads this file through its own interpolation after Ansible, and is then written as a JSON
  #     # string rather than between quotes, because YAML reads a quote or a backslash in it as
  #     # syntax. See this file's header for both, and for why "ensure_ascii=False" is not optional.
  #     SERVICE_API_KEY: {{ Artificial_Intelligence_service_API_key | replace('$', '$$') | to_json(ensure_ascii=False) }}
  #
  #   # A secret is never written in clear text in this repository, here or anywhere else. It is a
  #   # variable of this role, MANDATORY and without a default, that the caller fills from its vault,
  #   # and Ansible interpolates it into this file at render time like every other value -- which is
  #   # why the deployment role writes the rendered file "0600" and with "diff: false". There is one
  #   # form and not two: never a ".env", nor a "${VAR}" left for Compose to resolve from one. That
  #   # would be a second file to secure, a second path to keep in sync with the first, and a question
  #   # at the switch to Swarm that interpolating at render time never raises. Native orchestrator
  #   # secrets under "/run/secrets/" are an open question (#83), not an option yet.
  #   #
  #   # The one exception is a secret the service can genuinely do without, and it is rare (#245).
  #   # Its default is "false" -- never "''" -- which this role reads as "not set"; the lines that
  #   # carry it are written only inside a block conditioned on "X is string"; a task of its own in
  #   # "tasks/main.yml" accepts "false" or a non-empty string and nothing else, so that a value
  #   # which is given and unusable is refused rather than left out; and "FREE_FORM_WITH_A_DEFAULT"
  #   # in "check_compose_template.py" names it, since a default of "false" hides it from the "$" render.
  #
  #   networks:
  #     - {{ Artificial_Intelligence_internal_Docker_network_name }}
  #     # And this one IN ADDITION, only for a service with a web interface meant for a human: it is
  #     # how the caller's reverse proxy reaches it. Only write it inside a block conditioned on
  #     # "Artificial_Intelligence_published_Docker_network_name is string": on a caller that has not set the pair, the
  #     # network is not declared and the service would not start.
  #     - {{ Artificial_Intelligence_published_Docker_network_name }}
{% endraw %}

configs:
  # The files a container reads at start, one Docker config each, named after their content (#161):
  # a changed file is a new name, which is what makes Compose recreate the container and Swarm update
  # the service. "file" is the path of the rendered file on the host the stack is deployed from.
  {{ Artificial_Intelligence_LiteLLM_config_Docker_name }}:
    file: {{ Artificial_Intelligence_LiteLLM_config_file_destination_path | replace('$', '$$') | to_json(ensure_ascii=False) }}
  {{ Artificial_Intelligence_LibreChat_config_Docker_name }}:
    file: {{ Artificial_Intelligence_LibreChat_config_file_destination_path | replace('$', '$$') | to_json(ensure_ascii=False) }}

volumes:
  # The gateway's store. Named, so it survives a container recreation -- which #1 makes an acceptance
  # criterion rather than an assumption.
  {{ Artificial_Intelligence_PostgreSQL_data_Docker_volume_name }}:
  # OmniRoute's SQLite store (#73). Named, so it survives a container recreation.
  {{ Artificial_Intelligence_OmniRoute_data_Docker_volume_name }}:
  # Qdrant's storage (#3). Named, so it survives a container recreation.
  {{ Artificial_Intelligence_Qdrant_data_Docker_volume_name }}:
  # LibreChat's uploaded attachments and its MongoDB store (#76). Named, so both survive a container
  # recreation.
  {{ Artificial_Intelligence_LibreChat_uploads_Docker_volume_name }}:
  {{ Artificial_Intelligence_MongoDB_LibreChat_data_Docker_volume_name }}:
{% if Artificial_Intelligence_Claude_code_enabled %}
  # The Claude Code agent's WHOLE home directory (#13) -- not only "~/.claude". See the note in
  # "defaults/main.yml" on why the two cannot be split without losing the session on every recreation.
  {{ Artificial_Intelligence_Claude_code_home_Docker_volume_name }}:
{% if Artificial_Intelligence_Claude_code_workspace_directory is not string %}
  # Its working directory, unless the caller bind-mounts one of its own.
  {{ Artificial_Intelligence_Claude_code_workspace_Docker_volume_name }}:
{% endif %}
{% endif %}

  # Redis's own persistence (#71) -- "--save 60 1" above is worthless without a volume behind it.
  {{ Artificial_Intelligence_Redis_data_Docker_volume_name }}:

networks:
  # Internal to the stack: created and destroyed with it, reachable from nowhere else. It is what
  # lets a service publish no port.
  {{ Artificial_Intelligence_internal_Docker_network_name }}:
{% if Artificial_Intelligence_published_Docker_network_definition is string %}

  # The published network belongs to the caller, not to this stack: they create it, name it, and
  # attach their reverse proxy to it. We only hook onto it, hence the "external: true" its definition
  # carries. Nothing attaches to it until a service has a web interface.
  {{ Artificial_Intelligence_published_Docker_network_definition }}
{% endif %}
