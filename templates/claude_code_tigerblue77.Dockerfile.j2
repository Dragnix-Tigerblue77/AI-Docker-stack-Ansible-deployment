# Built on top of the published Claude Code image instead of installing the CLI a second time from
# a bare Node base: that image already carries the pinned CLI, the non-root "node" user, the
# auto-updater switched off, and the authentication-mount pattern its own README documents. Pinned
# by tag AND digest, per #13 -- never ":latest".
FROM ghcr.io/dragnix-tigerblue77/claude-code-docker-container:{{ Artificial_Intelligence_Claude_code_Docker_image_tag }}@{{ Artificial_Intelligence_Claude_code_Docker_image_digest }}

USER root

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    procps \
    build-essential \
    docker.io \
    && mkdir -p -m 755 /etc/apt/keyrings \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && chmod go+r /etc/apt/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

# The base image's Debian release ships Python >= 3.12 (Debian trixie's default "python3" is
# 3.13.5), which is what ansible-core has required since 2.20 -- the same floor #57 hit for this
# repository's own toolchain. Installed from PyPI rather than apt's "ansible" metapackage, which
# pulls a much larger dependency tree than this container needs; "--break-system-packages" is
# required either way, since this is the system interpreter (PEP 668).
RUN pip3 install --no-cache-dir --break-system-packages ansible-core=={{ Artificial_Intelligence_Claude_code_tigerblue77_ansible_core_version }}

# Restores "~/.claude.json" from the newest backup on the mounted home volume before Claude Code
# starts. The base image mounts the WHOLE home directory (see its own README on the authentication
# trap), but a freshly created volume has no "~/.claude.json" to find until this container has backed
# one up there itself at least once.
#
# The glob is expanded by "ls -t", never by the "test" builtin: "[ -f pattern* ]" does not reliably
# glob-expand inside "[", and errors with "too many arguments" the moment two or more backups exist --
# breaking silently in exactly the multi-backup case this script exists to handle.
RUN cat << 'EOS' > /entrypoint.sh
#!/bin/sh
latest_backup=$(ls -t /home/node/.claude/backups/.claude.json.backup* 2>/dev/null | head -n1)
[ -n "$latest_backup" ] && [ ! -f /home/node/.claude.json ] && cp "$latest_backup" /home/node/.claude.json
exec claude "$@"
EOS
RUN chmod +x /entrypoint.sh

USER node

ENTRYPOINT ["/entrypoint.sh"]
