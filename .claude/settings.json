{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(yamllint:*)",
      "Bash(ansible-lint)",
      "Bash(ansible-lint --offline)",
      "Bash(ansible-playbook --syntax-check:*)",
      "Bash(ansible --version)",
      "Bash(python3 .github/scripts/check_compose_template.py)",
      "Bash(python3 .github/scripts/check_compose_template.py --selftest)",
      "Bash(python3 .github/scripts/check_LiteLLM_account_isolation.py)",
      "Bash(python3 .github/scripts/check_LiteLLM_account_isolation.py --selftest)",
      "Bash(python3 .github/scripts/check_no_inventory_data.py)",
      "Bash(python3 .github/scripts/check_no_inventory_data.py --selftest)",
      "Bash(gitleaks dir:*)",
      "Bash(pip install -r requirements.txt)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch --show-current)",
      "Bash(git branch --list:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git rev-parse:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(ls:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "Bash(diff:*)",
      "Bash(shellcheck:*)"
    ]
  }
}
