{
  "name": "main",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "yamllint"
          },
          {
            "context": "REUSE compliance"
          },
          {
            "context": "ansible-lint"
          },
          {
            "context": "ansible-playbook --syntax-check"
          },
          {
            "context": "role run (Claude Code agent off)"
          },
          {
            "context": "role run (Claude Code agent on)"
          },
          {
            "context": "Repository rules"
          },
          {
            "context": "gitleaks"
          },
          {
            "context": "Pre-commit hook blocks a secret"
          },
          {
            "context": "sign-off"
          }
        ]
      }
    }
  ]
}
