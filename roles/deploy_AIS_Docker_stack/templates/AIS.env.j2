# Environment file of the AIS stack, RENDERED by Ansible from the caller's vault.
#
# No SPDX header, for the same reason the compose template carries none: this file is written onto
# the managed node, it is not a source file of this repository.
#
# It holds secrets in clear text. The role writes it 0600, with "no_log" and "diff: false" -- "--diff"
# would print the whole file into the run's output, and a leak that outlives the run is worse than
# the file itself.
#
# Compose reads it because it sits in the PROJECT DIRECTORY, which is the directory of the compose
# file. "docker stack deploy" does NOT read it: Swarm interpolates from the SHELL environment, so the
# Swarm migration needs either a "set -a; . ./.env" wrapper or native secrets. See the README.
POSTGRES_DB={{ AIS_PostgreSQL_database }}
POSTGRES_USER={{ AIS_PostgreSQL_user }}
POSTGRES_PASSWORD={{ AIS_PostgreSQL_password }}

# Administration only, and never handed to a consumer: every client gets its own virtual key with its
# own model allow-list (#2).
LITELLM_MASTER_KEY={{ AIS_LiteLLM_master_key }}
