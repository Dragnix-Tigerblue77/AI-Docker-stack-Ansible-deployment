router_settings:
  num_retries: 2
  retry_after: 2
  cooldown_time: 60
  allowed_fails: 1

  # Every cascade below stays inside tigerblue77's own keys, end to end -- there is only one account
  # in this file for v1 (see the note at the top), so there is nothing yet for a cascade to cross.
  # "check_LiteLLM_account_isolation.py" (#32) is what keeps that true once a second account's models
  # land here.
  fallbacks:
    # 1. PRO -- pure reasoning, multi-step logic, architecture.
    # Priority: Google Pro/Reasoning -> OpenRouter heavy -> Mistral Large -> Cerebras -> GitHub Models
    # -> OmniRoute.
    - pro:
        - gemini-3-1-pro
        - gemini-3-1-pro-customtools
        - gemini-2-5-pro
        - deep-research-pro
        - nemotron-ultra-free
        - mistral-large
        - glm-5-2-free
        - nemotron-reasoning-free
        - minimax-m3-free
        - gpt-oss-120b-cerebras
        - o3-mini-github
        - deepseek-r1-github
        - gpt-4o-github
        - llama-3-3-70b-github
        - omniroute-free-reasoning

    # 2. FLASH -- balanced daily driver.
    # Priority: Google Flash (1M) -> LPUs (Cerebras/Groq) -> Mistral -> OpenRouter -> GitHub Models ->
    # OmniRoute.
    - flash:
        - gemini-3-6-flash
        - gemini-3-5-flash
        - gemini-3-flash-preview
        - gemini-omni-1-1-flash
        - gpt-oss-120b-cerebras
        - gpt-oss-120b-groq
        - gemma-4-31b-cerebras
        - qwen3-8-27b-groq
        - compound-groq
        - mistral-small
        - nemotron-super-free
        - gemma-4-31b-free
        - minimax-m2-7-free
        - openrouter-auto-free
        - gpt-4o-mini-github
        - omniroute-free-auto

    # 3. FLASH-LITE -- atomic micro-tasks (<300ms). Accepts short-context (4k-32k) models for
    # ultra-high speed.
    - flash-lite:
        - gemini-3-1-flash-lite
        - gemini-2-5-flash-lite
        - gpt-oss-20b-groq
        - compound-mini-groq
        - qwen3-6-27b-groq
        - gemma-4-26b-free
        - nemotron-lightning-free
        - ling-flash-free
        - inkling-small-free
        - dots-note-free
        - poolside-laguna-xs-free
