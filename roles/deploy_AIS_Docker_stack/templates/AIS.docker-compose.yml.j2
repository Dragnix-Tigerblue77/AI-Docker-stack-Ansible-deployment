# AIS stack -- Artificial Intelligence Stack.
#
# This file is RENDERED onto the managed node: what is read here is a template, what lands there is
# an ordinary compose file. It deliberately carries no SPDX header, for the same reason
# "roles/*/templates/" is exempt on the homelab side: the header would end up copied into the
# deployed file, which is not a source file of this repository.
#
# No format "version:": the key has been obsolete since Compose v2, and Swarm never read it.

# Each service issue adds its block here, on the commented model below, and its variables in
# "defaults/main.yml".
services:

  # ------------------------------------------------------------------------------------------------
  # PostgreSQL -- the gateway's store (#1). It holds the virtual keys, the teams and the usage
  # ledger, which is the entire reason the gateway runs with a database rather than in file mode.
  # ------------------------------------------------------------------------------------------------
  postgres:
    # Major pinned EXPLICITLY, never ":latest": a major bump imposes a pg_dump / restore, so it must
    # never happen because a tag moved under us. Check the major is one the Prisma schema of the
    # chosen LiteLLM version supports before raising it.
    image: "postgres:{{ AIS_PostgreSQL_Docker_image_tag }}"

    environment:
      TZ: "{{ AIS_server_time_zone }}"
      # Interpolated by ANSIBLE, at render time -- not by Compose from a ".env" it would otherwise
      # need in the project directory. It is what lets the same template serve Compose and Swarm
      # unchanged: Ansible renders this file the same way regardless of which one reads it next. The
      # literal value never appears anywhere else -- it is why the caller's deployment role has to
      # write THIS file "0600" and with "diff: false".
      POSTGRES_DB: "{{ AIS_PostgreSQL_database }}"
      POSTGRES_USER: "{{ AIS_PostgreSQL_user }}"
      POSTGRES_PASSWORD: "{{ AIS_PostgreSQL_password }}"

    volumes:
      # A NAMED volume, not a bind mount: surviving a container recreation is an acceptance criterion
      # of #1, not a hope. A bind mount would also tie the stack to a host path, which this
      # repository does not get to choose.
      - "{{ AIS_PostgreSQL_data_Docker_volume_name }}:/var/lib/postgresql/data:rw"

    healthcheck:
      # "pg_isready" ships with the image, so this needs nothing the container does not already have.
      #
      # The user and the database are interpolated by ANSIBLE, at render time, rather than by the
      # shell inside the container. Both forms work; this one has no shell and no "$$" escaping to be
      # right about. Neither value is a secret -- they are ordinary defaults of this role -- so
      # writing them into the rendered file costs nothing, and "CMD" without a shell is one less
      # thing between the probe and its answer.
      test: ["CMD", "pg_isready", "-U", "{{ AIS_PostgreSQL_user }}", "-d", "{{ AIS_PostgreSQL_database }}"]
      interval: 5s
      timeout: 5s
      start_period: 10s
      retries: 5

    deploy:
      restart_policy:
        # "any", never "on-failure": the orchestrator stops an unhealthy container cleanly, so the
        # process exits 0, and "on-failure" never replaces a task that exited cleanly.
        condition: any
      resources:
        limits:
          # Starting value, to be recalled after measuring under load with "docker stats". What
          # matters today is that a limit EXISTS: without one, a container running away takes the
          # others down by OOM and the kernel log names the victim rather than the culprit.
          memory: "{{ AIS_PostgreSQL_memory_limit }}"

    networks:
      - {{ AIS_internal_Docker_network_name }}

  # ------------------------------------------------------------------------------------------------
  # LiteLLM Proxy -- the single point every LLM call of the estate goes through (#1).
  #
  # This container holds the Gemini / Groq / Mistral keys of BOTH accounts plus the master key. It is
  # the most sensitive component of the stack, which is exactly why its port is published under basic
  # auth rather than left open behind nothing: see "AIS_LiteLLM_UI_password" in "defaults/main.yml".
  # ------------------------------------------------------------------------------------------------
  litellm:
    # Explicit SemVer, never "main-latest": that tag is deprecated and no longer fed, so it freezes
    # the deployment on an old image while looking current. The security floor and the date it was
    # last verified live in "defaults/main.yml"; "tasks/main.yml" refuses a tag below the floor.
    image: "ghcr.io/berriai/litellm:{{ AIS_LiteLLM_Docker_image_tag }}"

    environment:
      TZ: "{{ AIS_server_time_zone }}"
      # "postgres" is the SERVICE KEY declared above -- that is what Docker resolves in DNS. A
      # container_name would work under Compose and break under Swarm, which names its own tasks.
      #
      # Interpolated by Ansible, like the two secrets below -- see the note on "POSTGRES_PASSWORD"
      # above. LiteLLM itself still reads both from ITS OWN container environment at "os.environ/...",
      # which "LiteLLM_config.yaml.j2" points at: what changes is where that environment variable gets
      # its value from, never how LiteLLM consumes it.
      DATABASE_URL: "postgresql://{{ AIS_PostgreSQL_user }}:{{ AIS_PostgreSQL_password }}@postgres:5432/{{ AIS_PostgreSQL_database }}"
      # Administration only, from Ansible. It is NEVER handed to a consumer: every client gets its
      # own virtual key with its own model allow-list (#2). A client holding this key makes the whole
      # isolation work of #2 pointless.
      LITELLM_MASTER_KEY: "{{ AIS_LiteLLM_master_key }}"
      STORE_MODEL_IN_DB: "True"
      # "/ui" is where each account's own provider keys get added, one at a time, by the person who
      # holds them -- see the note on "AIS_LiteLLM_UI_password" in "defaults/main.yml" for why that is
      # the deployment's model rather than a vaulted variable per provider. Basic auth in front of it
      # is what "ports:" below gives up by existing: it does not replace TLS, but it is not nothing.
      UI_USERNAME: "{{ AIS_LiteLLM_UI_username }}"
      UI_PASSWORD: "{{ AIS_LiteLLM_UI_password }}"

    volumes:
      # Read-only: the gateway reads its routing configuration, it does not rewrite it. #2 fills the
      # model list; what this role renders is the file and its general settings.
      - "{{ AIS_LiteLLM_config_file_destination_path }}:/app/config.yaml:ro"

    command:
      - "--config"
      - "/app/config.yaml"
      - "--port"
      - "4000"
      - "--num_workers"
      - "{{ AIS_LiteLLM_number_of_workers }}"

    # Published, and this reverses #1's own original call -- see "AIS_LiteLLM_UI_password" in
    # "defaults/main.yml" for why. "/ui" is where each account adds its own provider keys by hand, so
    # it has to be reachable with nothing more than a browser on the LAN, before the reverse proxy
    # this stack does not own exists to do it instead. The cost is real and is not waived by this
    # comment: no TLS, and basic auth (above) as the only thing standing between the master key's
    # container and the LAN. Revisit the day a reverse proxy is in front of it.
    ports:
      - "4000:4000"

    healthcheck:
      # "/health" requires authentication; "/health/liveliness" does not. Written with the image's
      # own Python rather than curl, whose presence is NOT guaranteed in the image -- a healthcheck
      # calling a binary that is not there fails closed, and the service sits unhealthy for a reason
      # that has nothing to do with the service.
      test:
        - "CMD"
        - "python"
        - "-c"
        - "import urllib.request; urllib.request.urlopen('http://localhost:4000/health/liveliness').read()"
      interval: 30s
      timeout: 10s
      # The first run applies the Prisma migrations, which is the slow start this window covers.
      start_period: 90s
      retries: 3

    # A Compose facility, and only that: SWARM IGNORES "depends_on". LiteLLM therefore has to
    # tolerate a database that is not ready yet -- it is the restart policy that catches that case,
    # not the start order. Kept because it spares the test bench a first failed start.
    depends_on:
      postgres:
        condition: service_healthy

    deploy:
      restart_policy:
        condition: any
      resources:
        limits:
          # Depends on "--num_workers": each worker replicates the configuration. With 88 threads on
          # the target host the temptation to raise the worker count is real, and this limit is what
          # bounds the experiment.
          memory: "{{ AIS_LiteLLM_memory_limit }}"

    networks:
      - {{ AIS_internal_Docker_network_name }}

  # ------------------------------------------------------------------------------------------------
  # OmniRoute -- the gateway's keyless, free, last-resort fallback (#73). No provider key is ever
  # connected to it: it is deliberately shared between every account, since there is no quota behind
  # it to isolate. "check_LiteLLM_account_isolation.py" (#2) exempts it from the isolation rules for
  # exactly this reason.
  # ------------------------------------------------------------------------------------------------
  omniroute:
    # Explicit SemVer, never ":latest" and never the "-web" variant -- see "defaults/main.yml".
    image: "diegosouzapw/omniroute:{{ AIS_OmniRoute_Docker_image_tag }}"

    environment:
      TZ: "{{ AIS_server_time_zone }}"
      # Overrides the image's own "CHANGEME" default, which upstream documents as deliberately weak
      # to force a change -- never left as-is, same standard as "AIS_LiteLLM_UI_password" (#1).
      INITIAL_PASSWORD: "{{ AIS_OmniRoute_dashboard_password }}"

    volumes:
      # Named, at the path the upstream Docker guide's own example mounts: "/app/data".
      - "{{ AIS_OmniRoute_data_Docker_volume_name }}:/app/data:rw"

    # Published, for the same reason as LiteLLM's "/ui" (#1): the dashboard needs to be reachable
    # from a browser on the LAN, and "INITIAL_PASSWORD" above is what stands in front of it.
    # "REQUIRE_API_KEY" is deliberately left at its default ("false"): this is the account-agnostic,
    # keyless fallback every account's cascade falls back to (#2), by design.
    ports:
      - "20128:20128"

    healthcheck:
      # No "curl" guaranteed in a Node.js image any more than in LiteLLM's -- written with the
      # runtime the image already has. "/livez" is the liveness endpoint the upstream Docker guide
      # documents.
      test:
        - "CMD"
        - "node"
        - "-e"
        - "require('http').get('http://localhost:20128/livez', r => process.exit(r.statusCode === 200 ? 0 : 1)).on('error', () => process.exit(1))"
      interval: 30s
      timeout: 10s
      start_period: 30s
      retries: 3

    deploy:
      restart_policy:
        condition: any
      resources:
        limits:
          memory: "{{ AIS_OmniRoute_memory_limit }}"

    networks:
      - {{ AIS_internal_Docker_network_name }}
{% if AIS_Claude_code_tigerblue77_enabled %}

  # ------------------------------------------------------------------------------------------------
  # Claude Code agent -- tigerblue77 (#13), OFF BY DEFAULT. #31 requires every service to declare
  # itself this way, and an agent that receives a person's own credentials is not something a fresh
  # deployment should run without being asked. Built on the published Claude Code image rather than
  # deployed straight from it: this account's own infrastructure work also needs "gh",
  # "ansible-core" and the build tooling its Dockerfile adds, none of which the base image carries.
  # ------------------------------------------------------------------------------------------------
  claude_code_tigerblue77:
    build:
      context: "{{ AIS_Claude_code_tigerblue77_build_context_directory }}"
    # A locally built image still names one, pinned to the published Claude Code image it was built
    # FROM -- the same reason every other image this template deploys carries an explicit tag.
    image: "ais-claude-code-tigerblue77:{{ AIS_Claude_code_Docker_image_tag }}"

    # Kept open rather than run-and-exit: this is a CLI meant to be reached with "docker exec", not a
    # server, and Claude Code's own entrypoint would otherwise exit the moment it reads EOF on stdin.
    stdin_open: true
    tty: true

    environment:
      TZ: "{{ AIS_server_time_zone }}"
      # Routed through the gateway (#1) on a MODEL ALIAS rather than a literal model name or
      # Anthropic's API directly -- #13's compliance point is that whatever this alias resolves to in
      # LiteLLM (#2) is never an Anthropic model backed by a subscription.
      ANTHROPIC_BASE_URL: "http://litellm:4000"
      ANTHROPIC_API_KEY: "{{ AIS_Claude_code_tigerblue77_virtual_key }}"
      ANTHROPIC_MODEL: "{{ AIS_Claude_code_tigerblue77_model }}"
      # The alias resolves to a model Claude Code does not recognise by name, so its own context
      # window enforcement -- built around the models it DOES know -- has to be told what to allow
      # rather than refusing an unrecognised one outright.
      CLAUDE_CODE_MAX_CONTEXT_TOKENS: "1000000"
      CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT: "1"
      GH_TOKEN: "{{ AIS_Claude_code_tigerblue77_GitHub_token }}"
      GITHUB_TOKEN: "{{ AIS_Claude_code_tigerblue77_GitHub_token }}"

    volumes:
      # The caller's own working tree for this agent -- a bind mount, and necessarily a host path:
      # this role does not get to invent one, hence no default on the variable that names it.
      - "{{ AIS_Claude_code_tigerblue77_workspace_directory }}:/workspace:rw"
      # The WHOLE home directory, "~/.claude.json" included -- see the note on
      # "AIS_Claude_code_tigerblue77_home_Docker_volume_name" in "defaults/main.yml" for why a volume
      # on "~/.claude" alone would silently lose half the session on every recreation.
      - "{{ AIS_Claude_code_tigerblue77_home_Docker_volume_name }}:/home/node:rw"

    # No "docker.sock" mount here: #11 has not yet designed the isolation an agent needs before it
    # can reach the host's Docker daemon, and this container waits for it rather than pre-empting it.

    # No "ports:": this is reached with "docker exec" and, later, through the MCP tool gateway (#7) --
    # never through a port published on the host.

    deploy:
      restart_policy:
        condition: any
      resources:
        limits:
          # Starting value, to be recalled after measuring under load: higher than a bare agent's
          # would be, since the image adds "gh", "ansible-core" and build tooling on top of the
          # published Claude Code image.
          memory: "{{ AIS_Claude_code_tigerblue77_memory_limit }}"

    depends_on:
      litellm:
        condition: service_healthy

    networks:
      - {{ AIS_internal_Docker_network_name }}
{% endif %}

{% raw %}
  # ------------------------------------------------------------------------------------------------
  # The model to copy. It describes no real service: it carries the conventions #31 sets, at the
  # place where they get forgotten.
  #
  # It is a fragment OF THIS TEMPLATE, not of the rendered file: it shows itself as it is typed,
  # Jinja expressions included. Hence the "raw" block around it, without which it would render each
  # variable's VALUE -- and "- False" for an unset published network.
  # ------------------------------------------------------------------------------------------------
  #
  # service_name:
  #   # Pinned by version, never ":latest" -- nor the implicit tag, which IS ":latest".
  #   # Without this, a redeployment months later installs a version nobody chose, and the failure
  #   # that follows has no diff to show.
  #   image: vendor/image:1.2.3
  #
  #   # Everything below lives under "deploy:", and that is deliberate: it is the only form BOTH
  #   # Compose and Swarm honour. "restart: unless-stopped", "mem_limit:" and "cpus:" work in Compose
  #   # and are IGNORED by Swarm -- silently, which is the worst of both worlds. Writing under
  #   # "deploy:" from the start means the move to Swarm does not reopen this file.
  #   deploy:
  #     restart_policy:
  #       # "any", never "on-failure". When a container turns unhealthy the orchestrator stops it
  #       # cleanly, the process exits 0, and "on-failure" never replaces a task that exited cleanly:
  #       # the service sits at 0 replicas, the reverse proxy stops building its router, and the URL
  #       # answers a bare 404 with nothing logged anywhere.
  #       condition: any
  #     resources:
  #       limits:
  #         # Mandatory on EVERY service. Without a limit, one container running away takes all the
  #         # others down by OOM, and the kernel log names the victim, not the culprit. An AI stack is
  #         # exactly the ground where that happens: a model held in memory, a worker handed a
  #         # document too large.
  #         memory: 512M
  #
  #   # No "ports:" for an internal service: it is reached over the stack's network, under its
  #   # service name. Only a web interface meant for a human is exposed, and it goes through the
  #   # caller's reverse proxy -- never through a port published on the host.
  #   #
  #   # No "container_name:" either: Swarm ignores it, and a hostname that only exists under Compose
  #   # is a dependency that breaks at the moment of the switch.
  #   #
  #   # A host port that IS allocated must dodge Chromium's restricted list: a restricted port is
  #   # refused inside the browser, before the connection leaves it, so the service stays healthy and
  #   # its logs stay empty.
  #
  #   # The image often ships one, better than anything written here: Docker inherits it as long as
  #   # the service declares none. Only write one to do better, not to do the same.
  #   healthcheck:
  #     test: ["CMD", "…"]
  #     interval: 30s
  #     timeout: 30s
  #     start_period: 10s
  #     retries: 3
  #
  #   environment:
  #     TZ: "{{ AIS_server_time_zone }}"
  #
  #   # A secret is never written in clear text here. Two forms are possible, one or the other
  #   # depending on the caller's orchestrator: a native secret mounted under "/run/secrets/", or a
  #   # variable drawn from an unversioned ".env". What is forbidden is the literal value.
  #
  #   networks:
  #     - {{ AIS_internal_Docker_network_name }}
  #     # And this one IN ADDITION, only for a service with a web interface meant for a human: it is
  #     # how the caller's reverse proxy reaches it. Only write it inside a block conditioned on
  #     # "AIS_published_Docker_network_name is string": on a caller that has not set the pair, the
  #     # network is not declared and the service would not start.
  #     - {{ AIS_published_Docker_network_name }}
{% endraw %}

volumes:
  # The gateway's store. Named, so it survives a container recreation -- which #1 makes an acceptance
  # criterion rather than an assumption.
  {{ AIS_PostgreSQL_data_Docker_volume_name }}:
  # OmniRoute's SQLite store (#73). Named, so it survives a container recreation.
  {{ AIS_OmniRoute_data_Docker_volume_name }}:
{% if AIS_Claude_code_tigerblue77_enabled %}
  # The Claude Code agent's WHOLE home directory (#13) -- not only "~/.claude". See the note in
  # "defaults/main.yml" on why the two cannot be split without losing the session on every recreation.
  {{ AIS_Claude_code_tigerblue77_home_Docker_volume_name }}:
{% endif %}

networks:
  # Internal to the stack: created and destroyed with it, reachable from nowhere else. It is what
  # lets a service publish no port.
  {{ AIS_internal_Docker_network_name }}:
{% if AIS_published_Docker_network_definition is string %}

  # The published network belongs to the caller, not to this stack: they create it, name it, and
  # attach their reverse proxy to it. We only hook onto it, hence the "external: true" its definition
  # carries. Nothing attaches to it until a service has a web interface.
  {{ AIS_published_Docker_network_definition }}
{% endif %}
