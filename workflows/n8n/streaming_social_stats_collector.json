      "id": "validate-format",
      "name": "Validate & stamp collected_at",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1520, 400],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const collectedAt = new Date().toISOString();\nconst required = ['platform', 'account_id', 'account_name', 'followers_count', 'views_recent_30d', 'views_average', 'account_status'];\n\nreturn items.map((item) => {\n  const data = item.json;\n  for (const field of required) {\n    if (!(field in data)) {\n      throw new Error(`Sous-workflow ${data.platform || '?'} : champ manquant '${field}' dans le schema commun`);\n    }\n  }\n  return { json: { ...data, collected_at: collectedAt } };\n});"
      }
