    {
      "id": "merge-user-followers",
      "name": "Merge user+followers",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [520, 40],
      "parameters": { "mode": "combine", "combineBy": "combineAll", "options": {} }
    },
    {
      "id": "code-normalize",
      "name": "Normalize to common schema",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [760, 100],
      "parameters": {
        "language": "javaScript",
        "jsCode": "const users = $('GET /helix/users').item.json.data[0];\nconst followers = $('GET /helix/channels/followers').item.json;\nconst videos = ($('GET /helix/videos (archive)').item.json.data) || [];\n\nconst since = new Date();\nsince.setDate(since.getDate() - 30);\n\nconst recentVods = videos.filter((v) => new Date(v.created_at) >= since);\nconst totalViews = recentVods.reduce((sum, v) => sum + (v.view_count || 0), 0);\n\nreturn [{\n  json: {\n    platform: 'twitch',\n    account_id: users.id,\n    account_name: users.display_name,\n    followers_count: followers.total ?? null,\n    views_recent_30d: recentVods.length ? totalViews : null,\n    views_average: recentVods.length ? Math.round(totalViews / recentVods.length) : null,\n    account_status: users.broadcaster_type || null\n  }\n}];"
      }
    }
  ],
