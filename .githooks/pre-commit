# Refuse a commit that carries a secret. This is the ONLY guard in this repository that really
# refuses anything: CI does no more than report after the fact, and the account is on a plan that
# allows neither a ruleset nor a branch protection on a private repository, so no CI check can be
# made blocking ("GET /repos/.../rulesets" -> 403 "Upgrade to GitHub Pro").
#
# Installation, once per clone -- a hook is not versioned, the DIRECTORY is:
#
#     git config core.hooksPath .githooks
#
# ! "git commit --no-verify" bypasses this hook without saying a word. That is a property of git,
#   not a defect to fix here: the bypass is a deliberate gesture, and the "gitleaks" workflow
#   catches it at the next pull request.
#
# ! The command is "gitleaks git --staged", and not "gitleaks protect --staged":
#   - "protect" has been hidden since v8.19.0 ("Hidden: true" in "cmd/protect.go"), is absent from
#     "--help", and still works without the slightest warning -- which is precisely what makes it a
#     trap: nothing will warn on the day it disappears;
#   - "git --staged" is the documented form ("scan staged commits (good for pre-commit)").
#
# ! A fake test key has to have REAL entropy. gitleaks filters its findings on the entropy of the
#   string, so "AIzaSy" followed by thirty-five zeroes is NOT detected (measured: "no leaks found",
#   commit accepted) whereas a string of the same shape with normal entropy is. Whoever tests this
#   hook with a constant filler will wrongly conclude that it does not work -- and whoever tests it
#   with a real key has just pasted that key into their shell history.

# ! Do NOT write "--pre-commit" without "--staged": measured, that form misses an already-staged
#   secret and exits 0. It is the worst of both worlds, a hook that reassures without seeing
#   anything.

set -uo pipefail

# The binary may come from the PATH, or have been dropped at the repository root by the same
# "curl | tar" the CI workflow uses. Both are accepted so that a contributor does not have to choose
# between installing a package and following CI to the letter.
if command -v gitleaks > /dev/null 2>&1; then
    GITLEAKS_BINARY="gitleaks"
elif [ -x "./gitleaks" ]; then
    GITLEAKS_BINARY="./gitleaks"
else
    # ! Fails CLOSED, deliberately. A "command -v gitleaks || exit 0" would make the hook silent for
    #   anyone who has not installed it -- that is, for the very person who needs it most, who would
    #   then believe themselves protected. A security hook that switches itself off is worse than an
    #   absent one, because it lies.
    printf '%s\n' "pre-commit: gitleaks is nowhere to be found, the commit is refused." >&2
    printf '%s\n' "  Install it:  https://github.com/gitleaks/gitleaks/releases  (version pinned by CI: 8.30.1)" >&2
    printf '%s\n' "  or drop the binary at the repository root under the name \"gitleaks\"." >&2
    printf '%s\n' "  Bypass it knowingly, as a last resort:  git commit --no-verify" >&2
    exit 1
fi

# "--redact": the report of a secret must not write that secret back out into a terminal, a shell
# history or a screenshot pasted into an issue.
if ! "$GITLEAKS_BINARY" git --staged --redact --no-banner; then
    printf '\n%s\n' "pre-commit: gitleaks found a secret in what is staged. Commit refused." >&2
    printf '%s\n' "  Remove the value from the file, THEN revoke it with the provider: a value that has only" >&2
    printf '%s\n' "  been removed from a file stays valid for as long as it has not been regenerated." >&2
    exit 1
fi

exit 0
